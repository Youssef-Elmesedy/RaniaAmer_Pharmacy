@model int

<li class="nav-item">
    <a class="nav-link position-relative" asp-controller="Cart" asp-action="Index">
        <i class="fa-solid fa-cart-shopping"></i>
        @if (Model > 0)
        {
            <span class="badge rounded-pill bg-danger position-absolute top-0 start-0" style="font-size:.65rem">@Model</span>
        }
    </a>
</li>
