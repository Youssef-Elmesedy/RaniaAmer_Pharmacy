@model List<OfferViewModel>
@{
    ViewData["Title"] = "العروض";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/offers.css" asp-append-version="true" />
}

<div class="bg-white border-bottom py-4 mb-4">
    <div class="container">
        <h2 class="fw-bold mb-0"><i class="fa-solid fa-tags me-2" style="color:var(--brand-gold)"></i>عروضنا الحالية</h2>
        <p class="text-muted mb-0">مجموعات مميزة من أصنافنا بأسعار خاصة</p>
    </div>
</div>

<div class="container pb-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa-solid fa-tags fa-3x text-muted mb-3"></i>
            <p class="text-muted">لا توجد عروض حالياً، تابعنا قريباً</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var offer in Model)
            {
                <div class="col-md-6">
                    <div class="card product-card p-3 h-100">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="fw-bold mb-0">@offer.Title</h4>
                            @if (offer.TotalSavings > 0)
                            {
                                <span class="badge badge-offer">وفر @offer.TotalSavings.ToString("0.00") ج.م</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(offer.Description))
                        {
                            <p class="text-muted small">@offer.Description</p>
                        }

                        <div class="row g-2 mb-3">
                            @foreach (var item in offer.Items)
                            {
                                <div class="col-4">
                                    <div class="text-center border rounded-3 p-2 h-100">
                                        <img src="@(item.ProductImagePath ?? "/images/seed/grills.svg")" class="rounded-2 mb-1"
                                             style="width:100%;height:70px;object-fit:cover" alt="@item.ProductName" />
                                        <div class="small fw-bold">@item.ProductName</div>
                                        <div class="small">
                                            <span class="price-old">@item.OriginalPrice.ToString("0.00")</span>
                                            <span class="price-new">@item.SpecialPrice.ToString("0.00")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <div>
                                <span class="price-old">@offer.TotalOriginalPrice.ToString("0.00") ج.م</span>
                                <span class="price-new fs-5 ms-2">@offer.TotalSpecialPrice.ToString("0.00") ج.م</span>
                            </div>
                        </div>

                        <div class="mt-2 d-flex flex-wrap gap-2">
                            @foreach (var item in offer.Items)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Offers")" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-cart-plus me-1"></i> أضف @item.ProductName
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
