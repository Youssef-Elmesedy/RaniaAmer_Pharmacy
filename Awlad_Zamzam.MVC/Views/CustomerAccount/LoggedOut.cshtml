@{
    ViewData["Title"] = "تم تسجيل الخروج";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/logout.css" asp-append-version="true" />
}

<div class="logout-wrapper">

    <div class="logout-card">

        <div class="logout-icon">
            👋
        </div>

        <h2>شكراً لزيارتك</h2>

        <p>
            تم تسجيل خروجك بنجاح.
            <br />
            نتمنى نشوفك مرة تانية قريب ❤️
        </p>

        <div class="buttons">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-danger">
                العودة للرئيسية
            </a>

            <a asp-controller="CustomerAccount"
               asp-action="Login"
               class="btn btn-outline-danger">
                تسجيل الدخول
            </a>

        </div>

    </div>

</div>