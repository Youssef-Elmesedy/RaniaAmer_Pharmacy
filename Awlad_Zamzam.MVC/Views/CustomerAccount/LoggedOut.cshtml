@{
    ViewData["Title"] = "تم تسجيل الخروج";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer-account.css" asp-append-version="true" />
}

<div class="customer-login-page">
    <div class="login-bg">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-xl-5 col-lg-6 col-md-8">

                <div class="login-card text-center py-5">

                    <div class="logo-circle mb-4 mx-auto" style="font-size: 2.5rem; background: rgba(220, 53, 69, 0.1);">
                        👋
                    </div>

                    <h2 class="fw-bold mb-3">شكراً لزيارتك</h2>

                    <p class="text-muted fs-5 mb-4 lh-base">
                        تم تسجيل خروجك بنجاح.
                        <br />
                        نتمنى رؤيتك مجدداً قريباً ❤️
                    </p>

                    <div class="d-flex flex-column gap-2 mt-4">
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn-login text-decoration-none">
                            <i class="fa-solid fa-house me-2"></i>
                            العودة للرئيسية
                        </a>

                        <a asp-controller="CustomerAccount"
                           asp-action="Login"
                           class="btn btn-outline-danger py-2 border-radius-12 fw-bold" style="border-radius: 12px; height: 48px; display: flex; align-items: center; justify-content: center;">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>
                            تسجيل الدخول
                        </a>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>