@model List<OrderListItemViewModel>

@{
    ViewData["Title"] = "طلباتي";

    var totalOrders = Model.Count;
    var completedOrders = Model.Count(x => x.Status == OrderStatus.Completed);
    var pendingOrders = Model.Count(x => x.Status == OrderStatus.Pending);
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/customer-credit-orders.css"
          asp-append-version="true" />
}

<div class="orders-page">

    <div class="container">

        <!-- Header -->

        <div class="orders-header">

            <a asp-action="MyCreditOrders"
               class="btn btn-outline-secondary credit-btn">

                <i class="fa-solid fa-clock me-2"></i>

                فواتير الآجل

            </a>

            <div class="header-content">

                <h2>

                    <i class="fa-solid fa-bag-shopping"></i>

                    طلباتي

                </h2>

                <p>

                    يمكنك متابعة جميع طلباتك وحالة كل طلب.

                </p>

            </div>

        </div>

        <!-- Statistics -->

        <div class="row g-4 mb-5">

            <div class="col-md-4">

                <div class="stat-card">

                    <i class="fa-solid fa-cart-shopping"></i>

                    <h3>@totalOrders</h3>

                    <span>إجمالي الطلبات</span>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stat-card">

                    <i class="fa-solid fa-hourglass-half"></i>

                    <h3>@pendingOrders</h3>

                    <span>قيد الانتظار</span>

                </div>

            </div>

            <div class="col-md-4">

                <div class="stat-card">

                    <i class="fa-solid fa-circle-check"></i>

                    <h3>@completedOrders</h3>

                    <span>تم التسليم</span>

                </div>

            </div>

        </div>

        @if (!Model.Any())
        {
            <div class="empty-card">

                <i class="fa-solid fa-cart-flatbed"></i>

                <h4>لا توجد طلبات</h4>

                <p>

                    لم تقم بإجراء أي طلب حتى الآن.

                </p>

            </div>
        }
        else
        {

            <div class="table-card">

                <div class="table-responsive">

                    <table class="table align-middle">

                        <thead>

                            <tr>

                                <th>التاريخ</th>

                                <th>الأصناف</th>

                                <th>الإجمالي</th>

                                <th>نوع الطلب</th>

                                <th>الحالة</th>

                                <th></th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {

                                <tr>

                                    <td>

                                        @order.OrderDate.ToString("yyyy/MM/dd")

                                        <br />

                                        <small class="text-muted">

                                            @order.OrderDate.ToString("hh:mm tt")

                                        </small>

                                    </td>

                                    <td>

                                        @order.ItemsCount

                                    </td>

                                    <td class="fw-bold">

                                        @order.Total.ToString("0.00") ج.م

                                    </td>

                                    <td>

                                        @if (order.Status == OrderStatus.Completed && order.IsCredit)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="fa-solid fa-clock"></i>

                                                آجل

                                            </span>
                                        }
                                        else if (order.Status == OrderStatus.Completed)
                                        {
                                            <span class="badge bg-secondary">

                                                <i class="fa-solid fa-money-bill"></i>

                                                كاش

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">

                                                غير محدد

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @if (order.Status == OrderStatus.Pending)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="fa-solid fa-hourglass-half"></i>

                                                قيد الانتظار

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">

                                                <i class="fa-solid fa-check"></i>

                                                تم التسليم

                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-action="OrderDetails"
                                           asp-route-id="@order.Id"
                                           class="btn btn-view">

                                            <i class="fa-solid fa-eye"></i>

                                            التفاصيل

                                        </a>

                                    </td>

                                </tr>

                            }

                        </tbody>

                    </table>

                </div>

            </div>

        }

    </div>

</div>
@section Scripts {
    <script>
        // إذا رجع المستخدم للصفحة عن طريق زر الرجوع في المتصفح بعد الخروج، يتم عمل Refresh آلي
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });
    </script>
}