@model List<OrderListItemViewModel>
@{
    ViewData["Title"] = "طلباتي";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer-account.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">طلباتي</h3>
        <a asp-action="MyCreditOrders" class="btn btn-outline-secondary">
            <i class="fa-solid fa-clock me-1"></i> فواتير الآجل فقط
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">لا توجد طلبات بعد</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>عدد الأصناف</th>
                            <th>الإجمالي</th>
                            <th>النوع</th>
                            <th>الحالة</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@order.ItemsCount</td>
                                <td class="fw-bold">@order.Total.ToString("0.00") ج.م</td>
                                <td>
                                    @if (order.Status == OrderStatus.Completed && order.IsCredit)
                                    {
                                        <span class="badge bg-warning text-dark">آجل</span>
                                    }
                                    else if (order.Status == OrderStatus.Completed)
                                    {
                                        <span class="badge bg-secondary">كاش</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (order.Status == OrderStatus.Pending)
                                    {
                                        <span class="badge bg-danger">قيد الانتظار</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">تم التسليم</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
