@model ResetPasswordViewModel

@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer-account.css" asp-append-version="true" />
}

<div class="customer-login-page">
    <div class="login-bg">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-xl-5 col-lg-6 col-md-8">

                <a asp-action="ForgotPassword" class="back-home">
                    <i class="fa-solid fa-arrow-right"></i>
                    الرجوع للخطوة السابقة
                </a>

                <div class="login-card">
                    <div class="text-center mb-4">
                        <div class="logo-circle">
                            <i class="fa-solid fa-lock-open"></i>
                        </div>
                        <h2 class="fw-bold mt-4">إعادة تعيين كلمة المرور</h2>
                        <p class="text-muted">أجب على سؤال الأمان وأدخل كلمة المرور الجديدة</p>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <input type="hidden" asp-for="PhoneNumber" />
                        <input type="hidden" asp-for="SecurityQuestion" />

                        <!-- سؤال الأمان -->
                        <div class="mb-3">
                            <div class="input-group-custom">
                                <i class="fa-solid fa-shield-halved"></i>
                                <input class="form-control readonly-input" value="@Model.SecurityQuestion" readonly />
                            </div>
                        </div>

                        <!-- إجابة سؤال الأمان -->
                        <div class="mb-3">
                            <div class="input-group-custom">
                                <i class="fa-solid fa-comment-dots"></i>
                                <input asp-for="SecurityAnswer" class="form-control" placeholder="إجابة سؤال الأمان" autofocus />
                            </div>
                            <span asp-validation-for="SecurityAnswer" class="text-danger"></span>
                        </div>

                        <!-- كلمة المرور الجديدة -->
                        <div class="mb-3">
                            <div class="input-group-custom password-box">
                                <i class="fa-solid fa-key"></i>
                                <input asp-for="NewPassword" type="password" class="form-control" id="newPassword" placeholder="كلمة المرور الجديدة" />
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <!-- تأكيد كلمة المرور -->
                        <div class="mb-4">
                            <div class="input-group-custom password-box">
                                <i class="fa-solid fa-check-double"></i>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="تأكيد كلمة المرور" />
                            </div>
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn-login">
                            <i class="fa-solid fa-rotate-left me-2"></i>
                            تغيير كلمة المرور
                        </button>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}