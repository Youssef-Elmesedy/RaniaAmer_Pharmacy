@model CustomerLoginViewModel

@{
    ViewData["Title"] = "تسجيل الدخول";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer-account.css" asp-append-version="true" />
}

<div class="customer-login-page">
    <div class="login-bg">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-xl-5 col-lg-6 col-md-8">

                <a asp-controller="Home" asp-action="Index" class="back-home">
                    <i class="fa-solid fa-arrow-right"></i>
                    العودة للرئيسية
                </a>

                <div class="login-card">
                    <div class="text-center mb-4">
                        <div class="logo-circle">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <h2 class="fw-bold mt-4">أهلاً بك</h2>
                        <p class="text-muted">سجل دخولك للوصول إلى حسابك</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- رقم الهاتف -->
                        <div class="mb-3">
                            <div class="input-group-custom">
                                <i class="fa-solid fa-phone"></i>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" autofocus />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <!-- كلمة المرور -->
                        <div class="mb-2">
                            <div class="input-group-custom password-box">
                                <i class="fa-solid fa-lock"></i>
                                <input asp-for="Password" class="form-control" id="passwordInput" placeholder="كلمة المرور" />
                                <button type="button" id="togglePassword">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <!-- رابط نسيت كلمة المرور منفصل ومحاذى لليمين -->
                        <div class="text-start mb-4">
                            <a asp-action="ForgotPassword" class="forgot-link">نسيت كلمة المرور؟</a>
                        </div>

                        <button type="submit" class="btn-login">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>
                            تسجيل الدخول
                        </button>
                    </form>

                    <!-- رابط إنشاء حساب -->
                    <div class="register-box">
                        ليس لديك حساب؟
                        <a asp-action="Register" class="ms-1">إنشاء حساب جديد</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const toggle = document.getElementById("togglePassword");
        const password = document.getElementById("passwordInput");

        if (toggle && password) {
            toggle.onclick = function() {
                if (password.type === "password") {
                    password.type = "text";
                    toggle.innerHTML = '<i class="fa-solid fa-eye-slash"></i>';
                } else {
                    password.type = "password";
                    toggle.innerHTML = '<i class="fa-solid fa-eye"></i>';
                }
            };
        }
    </script>
}