@model OrderDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الطلب";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer-account.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">تفاصيل الطلب</h3>
        <a asp-action="MyOrders" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-right me-1"></i> رجوع
        </a>
    </div>

    <div class="card border-0 shadow-sm p-4 mb-3">
        <p class="mb-1"><strong>التاريخ:</strong> @Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>
        <p class="mb-1">
            <strong>النوع:</strong>
            @if (Model.Status == OrderStatus.Completed && Model.IsCredit)
            {
                <span class="badge bg-warning text-dark">آجل</span>
            }
            else if (Model.Status == OrderStatus.Completed)
            {
                <span class="badge bg-secondary">كاش</span>
            }
            else
            {
                <span class="badge bg-danger">قيد الانتظار</span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <p class="mb-0"><strong>ملاحظات:</strong> @Model.Notes</p>
        }
    </div>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>المنتج</th>
                        <th>السعر</th>
                        <th>الكمية</th>
                        <th>الإجمالي</th>
                        <th>ملاحظة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.UnitPrice.ToString("0.00") ج.م</td>
                            <td>@item.Quantity</td>
                            <td class="fw-bold">@item.LineTotal.ToString("0.00") ج.م</td>
                            <td class="text-muted small">@item.Note</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="3" class="text-end fw-bold">الإجمالي</td>
                        <td class="fw-bold price-new">@Model.Total.ToString("0.00") ج.م</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    @if (Model.IsCredit && Model.Status == OrderStatus.Completed)
    {
        <div class="card border-0 shadow-sm p-4 mt-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-money-bill-wave me-2"></i>سجل السداد</h5>
                <div class="text-end">
                    <div class="small text-muted">المدفوع: @Model.AmountPaid.ToString("0.00") ج.م</div>
                    <div class="fw-bold @(Model.IsFullyPaid ? "text-success" : "text-danger")">
                        المتبقي: @Model.RemainingBalance.ToString("0.00") ج.م
                    </div>
                </div>
            </div>

            @if (Model.Payments.Any())
            {
                <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>التاريخ</th>
                            <th>المبلغ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model.Payments)
                        {
                            <tr>
                                <td>@payment.PaidAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-bold">@payment.Amount.ToString("0.00") ج.م</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">لا توجد دفعات مسجلة بعد</p>
            }
        </div>
    }
</div>
