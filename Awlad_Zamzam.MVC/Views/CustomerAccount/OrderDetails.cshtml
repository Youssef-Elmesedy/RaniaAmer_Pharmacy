@model OrderDetailsViewModel

@{
    ViewData["Title"] = "تفاصيل الطلب";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/pages/customer-order-details.css"
          asp-append-version="true" />
}

<div class="order-details-page">

    <div class="container">

        <!-- Header -->

        <div class="details-header">

            <div>

                <h2>

                    <i class="fa-solid fa-bag-shopping"></i>

                    تفاصيل الطلب

                </h2>

                <p>

                    يمكنك مراجعة جميع تفاصيل الطلب وسجل السداد.

                </p>

            </div>

            <a asp-action="MyOrders"
               class="btn btn-outline-secondary">

                <i class="fa-solid fa-arrow-right"></i>

                رجوع

            </a>

        </div>

        <!-- Summary -->

        <div class="row g-4 mb-4">

            <div class="col-lg-3 col-md-6">

                <div class="summary-card">

                    <i class="fa-solid fa-calendar-days"></i>

                    <span>التاريخ</span>

                    <strong>

                        @Model.OrderDate.ToEgyptTime().ToString("yyyy/MM/dd")

                    </strong>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="summary-card">

                    <i class="fa-solid fa-money-bill-wave"></i>

                    <span>إجمالي الطلب</span>

                    <strong>

                        @Model.Total.ToString("0.00") ج.م

                    </strong>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="summary-card">

                    <i class="fa-solid fa-box"></i>

                    <span>عدد المنتجات</span>

                    <strong>

                        @Model.Items.Count

                    </strong>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="summary-card">

                    <i class="fa-solid fa-credit-card"></i>

                    <span>نوع الطلب</span>

                    <strong>

                        @if (Model.Status == OrderStatus.Completed && Model.IsCredit)
                        {
                            <span class="badge bg-warning text-dark">آجل</span>
                        }
                        else if (Model.Status == OrderStatus.Completed)
                        {
                            <span class="badge bg-secondary">كاش</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">قيد الانتظار</span>
                        }

                    </strong>

                </div>

            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="info-card mb-4">

                <h5>

                    <i class="fa-solid fa-note-sticky"></i>

                    ملاحظات الطلب

                </h5>

                <p class="mb-0">

                    @Model.Notes

                </p>

            </div>
        }

        <!-- Products -->

        <div class="table-card mb-4">

            <div class="card-title">

                <i class="fa-solid fa-cart-shopping"></i>

                المنتجات

            </div>

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>

                        <tr>

                            <th>المنتج</th>

                            <th>السعر</th>

                            <th>الكمية</th>

                            <th>الإجمالي</th>

                            <th>ملاحظة</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {

                            <tr>

                                <td class="fw-bold">

                                    @item.ProductName

                                </td>

                                <td>

                                    @item.UnitPrice.ToString("0.00") ج.م / @item.UnitLabel

                                </td>

                                <td>

                                    @item.Quantity.ToString("0.##") @item.UnitLabel

                                </td>

                                <td class="text-danger fw-bold">

                                    @item.LineTotal.ToString("0.00") ج.م

                                </td>

                                <td>

                                    @item.Note

                                </td>

                            </tr>

                        }

                    </tbody>

                    <tfoot>

                        <tr>

                            <td colspan="3" class="text-end fw-bold">

                                الإجمالي

                            </td>

                            <td class="fw-bold text-danger">

                                @Model.Total.ToString("0.00") ج.م

                            </td>

                            <td></td>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

        @if (Model.IsCredit && Model.Status == OrderStatus.Completed)
        {

            <div class="payment-card">

                <div class="payment-header">

                    <h4>

                        <i class="fa-solid fa-wallet"></i>

                        سجل السداد

                    </h4>

                    <div>

                        <div>

                            المدفوع :

                            <strong>

                                @Model.AmountPaid.ToString("0.00") ج.م

                            </strong>

                        </div>

                        <div class="@(Model.IsFullyPaid ? "text-success" : "text-danger")">

                            المتبقي :

                            <strong>

                                @Model.RemainingBalance.ToString("0.00") ج.م

                            </strong>

                        </div>

                    </div>

                </div>

                @if (Model.Payments.Any())
                {

                    <div class="table-responsive">

                        <table class="table align-middle">

                            <thead>

                                <tr>

                                    <th>التاريخ</th>

                                    <th>المبلغ</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var payment in Model.Payments)
                                {

                                    <tr>

                                        <td>

                                            @payment.PaidAt.ToEgyptTime().ToString("yyyy/MM/dd HH:mm")

                                        </td>

                                        <td class="fw-bold text-success">

                                            @payment.Amount.ToString("0.00") ج.م

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="text-center py-4 text-muted">

                        <i class="fa-solid fa-circle-info fa-2x mb-3"></i>

                        <p class="mb-0">

                            لا توجد دفعات مسجلة حتى الآن.

                        </p>

                    </div>

                }

            </div>

        }

    </div>

</div>

@section Scripts {
    <script>
        // إذا رجع المستخدم للصفحة عن طريق زر الرجوع في المتصفح بعد الخروج، يتم عمل Refresh آلي
        window.addEventListener('pageshow', function (event) {
            if (event.persisted) {
                window.location.reload();
            }
        });
    </script>
}