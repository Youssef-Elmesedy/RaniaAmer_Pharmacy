@model List<OrderListItemViewModel>
@{
    ViewData["Title"] = "فواتير الآجل";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer-account.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0"><i class="fa-solid fa-clock me-2"></i>فواتير الآجل</h3>
        <a asp-action="MyOrders" class="btn btn-outline-secondary">كل الطلبات</a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">لا توجد فواتير آجل</div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>عدد الأصناف</th>
                            <th>الإجمالي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@order.ItemsCount</td>
                                <td class="fw-bold">@order.Total.ToString("0.00") ج.م</td>
                                <td>@order.AmountPaid.ToString("0.00") ج.م</td>
                                <td class="fw-bold @(order.IsFullyPaid ? "text-success" : "text-danger")">
                                    @if (order.IsFullyPaid)
                                    {
                                        <span><i class="fa-solid fa-circle-check me-1"></i>مسدد</span>
                                    }
                                    else
                                    {
                                        @order.RemainingBalance.ToString("0.00")<text> ج.م</text>
                                    }
                                </td>
                                <td>
                                    <a asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="4" class="text-end fw-bold">إجمالي المتبقي عليك</td>
                            <td class="fw-bold price-new" colspan="2">@Model.Sum(o => o.RemainingBalance).ToString("0.00") ج.م</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
</div>
