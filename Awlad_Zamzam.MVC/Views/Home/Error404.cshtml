@{
    ViewData["Title"] = "الصفحة غير موجودة";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/not-found.css" asp-append-version="true" />
}

<div class="not-found-page">
    <div class="container py-5">
        <div class="not-found-card shadow-sm border-0 mx-auto">
            <!-- الأيقونة التعبيرية المتحركة -->
            <div class="not-found-icon-wrap mb-4">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <!-- رقم الخطأ البارز -->
            <h1 class="error-code fw-bold mb-2">404</h1>

            <h3 class="fw-bold text-dark mb-3">عذراً، الصفحة غير موجودة!</h3>

            <p class="lead text-muted fs-6 mb-4 px-lg-4">
                يبدو أن الصفحة التي تبحث عنها قد تم نقلها، حذفها، أو أنك قمت بإدخال رابط غير صحيح. دعنا نعيدك إلى مسار الأمان واللذة!
            </p>

            <!-- الأزرار التوجيهية -->
            <div class="d-flex flex-wrap justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-brand btn-lg px-4 rounded-3 shadow-sm">
                    <i class="fa-solid fa-house me-2"></i> العودة للرئيسية
                </a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-3">
                    <i class="fa-solid fa-utensils me-2"></i> تصفح المنتجات
                </a>
            </div>
        </div>
    </div>
</div>