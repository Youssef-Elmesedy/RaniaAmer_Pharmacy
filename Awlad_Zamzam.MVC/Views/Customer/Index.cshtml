@{
    ViewData["Title"] = "تواصل معنا";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/contact.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/contact.js" asp-append-version="true"></script>
}

<!-- Hero -->
<section class="contact-hero">

    <div class="container">

        <div class="row align-items-center gy-5">

            <div class="col-lg-6">

                <span class="hero-badge">
                    <i class="fa-solid fa-headset"></i>
                    تواصل معنا
                </span>

                <h1 class="hero-title">
                    يسعدنا خدمتك فى أى وقت
                </h1>

                <p class="hero-text">
                    فريق أولاد زمزم جاهز لاستقبال جميع استفساراتكم وطلباتكم،
                    ونسعد دائماً بخدمتكم بأفضل جودة وأسرع وقت.
                </p>

                <div class="hero-buttons">

                    <a href="tel:01019463877"
                       class="btn btn-brand btn-lg">

                        <i class="fa-solid fa-phone"></i>

                        اتصال مباشر

                    </a>

                    <a href="https://wa.me/201019463877"
                       target="_blank"
                       class="btn btn-success btn-lg">

                        <i class="fab fa-whatsapp"></i>

                        واتساب

                    </a>

                </div>

            </div>

            @* <div class="col-lg-6">

                <div class="hero-image">

                    <img src="~/images/contact-hero.png"
                         asp-append-version="true"
                         alt="Contact">

                </div>

            </div> *@

        </div>

    </div>

</section>

<!-- Contact Info -->

<section class="contact-info-section">

    <div class="container">

        <div class="section-title">

            <span>بيانات التواصل</span>

            <h2>يمكنك الوصول إلينا بسهولة</h2>

        </div>

        <div class="row g-4">

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-phone"></i>

                    </div>

                    <h4>الهاتف</h4>

                    <p>01019463877</p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>

                    <h4>العنوان</h4>

                    <p>
                        مدينة السادات
                        <br>
                        المنطقة الثالثة
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-clock"></i>

                    </div>

                    <h4>مواعيد العمل</h4>

                    <p>

                        يومياً

                        <br>

                        9 صباحاً - 1 مساءً

                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-truck-fast"></i>

                    </div>

                    <h4>التوصيل</h4>

                    <p>

                        داخل مدينة السادات

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Map + Form -->

<section class="contact-area">

    <div class="container">

        <div class="row g-5">

            <div class="col-lg-7">

                <div class="map-card">

                    <div class="card-title">

                        <i class="fa-solid fa-map-location-dot"></i>

                        موقعنا

                    </div>

                    <iframe src="https://www.google.com/maps?q=30.3675325,30.5096412&z=17&output=embed"
                            loading="lazy"
                            allowfullscreen>
                    </iframe>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="message-card">

                    <div class="card-title">

                        <i class="fa-solid fa-paper-plane"></i>

                        أرسل رسالة

                    </div>

                    <form>

                        <div class="mb-3">

                            <input class="form-control"
                                   placeholder="الاسم بالكامل">

                        </div>

                        <div class="mb-3">

                            <input class="form-control"
                                   placeholder="رقم الهاتف">

                        </div>

                        <div class="mb-3">

                            <input class="form-control"
                                   placeholder="البريد الإلكتروني">

                        </div>

                        <div class="mb-3">

                            <textarea class="form-control"
                                      rows="6"
                                      placeholder="اكتب رسالتك"></textarea>

                        </div>

                        <button class="btn btn-brand w-100">

                            <i class="fa-solid fa-paper-plane"></i>

                            إرسال الرسالة

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Social -->

<section class="social-section">

    <div class="container">

        <div class="section-title">

            <span>تابعنا</span>

            <h2>ابق على تواصل معنا</h2>

        </div>

        <div class="social-links">

            <a href="#" class="facebook">

                <i class="fab fa-facebook-f"></i>

            </a>

            <a href="#" class="instagram">

                <i class="fab fa-instagram"></i>

            </a>

            <a href="#" class="whatsapp">

                <i class="fab fa-whatsapp"></i>

            </a>

        </div>

    </div>

</section>