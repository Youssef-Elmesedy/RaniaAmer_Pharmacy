@{
    ViewData["Title"] = "تواصل معنا";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/contact.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/contact.js" asp-append-version="true"></script>
}

<!-- Hero -->
<section class="contact-hero">

    <div class="container">

        <div class="row align-items-center gy-5">

            <div class="col-lg-6">

                <span class="hero-badge">
                    <i class="fa-solid fa-headset"></i>
                    تواصل معنا
                </span>

                <h1 class="hero-title">
                    يسعدنا خدمتك فى أى وقت
                </h1>

                <p class="hero-text">
                    فريق أولاد زمزم جاهز لاستقبال جميع استفساراتكم وطلباتكم،
                    ونسعد دائماً بخدمتكم بأفضل جودة وأسرع وقت.
                </p>

                <div class="hero-buttons">

                    <a href="tel:01019463877"
                       class="btn btn-brand btn-lg">

                        <i class="fa-solid fa-phone"></i>

                        اتصال مباشر

                    </a>

                    <a href="https://wa.me/201019463877"
                       target="_blank"
                       class="btn btn-success btn-lg">

                        <i class="fab fa-whatsapp"></i>

                        واتساب

                    </a>

                </div>

            </div>

            @* <div class="col-lg-6">

                <div class="hero-image">

                    <img src="~/images/contact-hero.png"
                         asp-append-version="true"
                         alt="Contact">

                </div>

            </div> *@

        </div>

    </div>

</section>

<!-- Contact Info -->

<section class="contact-info-section">

    <div class="container">

        <div class="section-title">

            <span>بيانات التواصل</span>

            <h2>يمكنك الوصول إلينا بسهولة</h2>

        </div>

        <div class="row g-4">

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-phone"></i>

                    </div>

                    <h4>الهاتف</h4>

                    <p>01019463877</p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>

                    <h4>العنوان</h4>

                    <p>
                        مدينة السادات
                        <br>
                        المنطقة الثالثة
                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-clock"></i>

                    </div>

                    <h4>مواعيد العمل</h4>

                    <p>

                        يومياً

                        <br>

                        9 صباحاً - 1 مساءً

                    </p>

                </div>

            </div>

            <div class="col-md-6 col-xl-3">

                <div class="contact-box">

                    <div class="box-icon">

                        <i class="fa-solid fa-truck-fast"></i>

                    </div>

                    <h4>التوصيل</h4>

                    <p>

                        داخل مدينة السادات

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- Map + Form -->

<section class="contact-area">
    <div class="container">
        <div class="row">
            <div class="col-12">

                <div class="d-flex justify-content-end mb-3">
                    <a href="https://www.google.com/maps/dir/30.3556916,30.5163944/%D8%AC%D8%B2%D8%A7%D8%B1%D8%A9+%D8%A7%D9%88%D9%84%D8%A7%D8%AF+%D8%AD%D9%85%D8%B2%D8%A9%D8%8C+35+%D8%B7%D8%B1%D9%8A%D9%82+%D8%A7%D9%84%D9%82%D8%A7%D9%87%D8%B1%D8%A9+-+%D8%A7%D9%84%D8%A5%D8%B3%D9%83%D9%86%D8%AF%D8%B1%D9%8A%D8%A9+%D8%A7%D9%84%D8%B5%D8%AD%D8%B1%D8%A7%D9%88%D9%8A%D8%8C+%D9%85%D8%AF%D9%8A%D9%86%D8%A9+%D8%A7%D9%84%D8%B3%D8%A7%D8%AF%D8%A7%D8%AA%D8%8C+%D9%85%D8%AD%D8%A7%D9%81%D8%B8%D8%A9+%D8%A7%D9%84%D8%A8%D8%AD%D9%8A%D8%B1%D8%A9+6010370%E2%80%AD/@@30.3675793,30.510607,124m/data=!3m1!1e3!4m10!4m9!1m1!4e1!1m5!1m1!1s0x1458bfd42bb59625:0x4047d2a547d6d6c0!2m2!1d30.509738!2d30.3675793!3e0?entry=ttu&g_ep=EgoyMDI2MDcyMS4wIKXMDSoASAFQAw%3D%3D"
                       target="_blank"
                       class="btn btn-danger">
                        <i class="fas fa-location-arrow me-2"></i>
                        احصل على الاتجاهات
                    </a>
                </div>

                <div class="map-card">
                    <div class="card-title">
                        <i class="fa-solid fa-map-location-dot"></i>
                        موقع أولاد زمزم على الخريطة
                    </div>

                    <iframe src="https://www.google.com/maps?q=30.3675793,30.509738&z=18&output=embed"
                            loading="lazy"
                            allowfullscreen>
                    </iframe>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Social -->

<section class="social-section">

    <div class="container">

        <div class="section-title">

            <span>تابعنا</span>

            <h2>ابق على تواصل معنا</h2>

        </div>
        <div class="social-grid">

            <a href="#" class="social-card facebook">

                <div class="social-icon">
                    <i class="fab fa-facebook-f"></i>
                </div>

                <div>
                    <h5>Facebook</h5>
                    <span>تابع آخر العروض</span>
                </div>

            </a>

            <a href="#" class="social-card instagram">

                <div class="social-icon">
                    <i class="fab fa-instagram"></i>
                </div>

                <div>
                    <h5>Instagram</h5>
                    <span>شاهد أحدث المنتجات</span>
                </div>

            </a>

            <a href="https://wa.me/201019463877"
               class="social-card whatsapp">

                <div class="social-icon">
                    <i class="fab fa-whatsapp"></i>
                </div>

                <div>
                    <h5>WhatsApp</h5>
                    <span>تواصل معنا مباشرة</span>
                </div>

            </a>

        </div>

    </div>

</section>