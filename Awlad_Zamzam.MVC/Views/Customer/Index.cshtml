@model CustomerViewModel
@{
    ViewData["Title"] = "تواصل معنا";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/contact.css" asp-append-version="true" />
}

<div class="container py-5">
    <div class="row g-5">
        <div class="col-md-5">
            <h2 class="fw-bold mb-3">تواصل معنا</h2>
            <p class="text-muted mb-4">اترك بياناتك وسنتواصل معك في أقرب وقت لتلبية طلبك</p>

            <p class="mb-2"><i class="fa-solid fa-phone me-2" style="color:var(--brand-red)"></i>01019463877</p>
            <p class="mb-2"><i class="fa-solid fa-location-dot me-2" style="color:var(--brand-red)"></i>مدينه السادات المنطقه 3 برج المحمل</p>
            <p class="mb-2"><i class="fa-solid fa-clock me-2" style="color:var(--brand-red)"></i>يومياً 9 ص - 1 م</p>

            <div class="ratio ratio-16x9 mt-4 rounded-4 overflow-hidden bg-secondary-subtle d-flex align-items-center justify-content-center">
                <span class="text-muted"><i class="fa-solid fa-map-location-dot fa-2x"></i></span>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm p-4">
                <form asp-action="Index" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="اسمك بالكامل" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="العنوان بالتفصيل"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-brand w-100">
                        <i class="fa-solid fa-paper-plane me-2"></i>إرسال
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
