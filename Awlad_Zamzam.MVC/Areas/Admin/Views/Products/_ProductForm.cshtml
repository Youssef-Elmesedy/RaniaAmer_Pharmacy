@model ProductFormViewModel

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ExistingImagePath" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

<div class="row g-3">
    <!-- اسم المنتج -->
    <div class="col-12 col-md-6">
        <label asp-for="Name" class="form-label fw-semibold">اسم المنتج</label>
        <input asp-for="Name" class="form-control" placeholder="مثال: كفتة بلدي، كيلو لحم شواية..." />
        <span asp-validation-for="Name" class="text-danger extra-small"></span>
    </div>

    <!-- القسم -->
    <div class="col-12 col-md-6">
        <label asp-for="CategoryId" class="form-label fw-semibold">القسم</label>
        <select asp-for="CategoryId" class="form-select"
                asp-items="Model.Categories.Select(c => new SelectListItem(c.Name, c.Id.ToString()))">
            <option value="">-- اختر القسم --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger extra-small"></span>
    </div>

    <!-- الوصف -->
    <div class="col-12">
        <label asp-for="Description" class="form-label fw-semibold">وصف المنتج</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="تفاصيل ومكونات المنتج..."></textarea>
        <span asp-validation-for="Description" class="text-danger extra-small"></span>
    </div>

    <!-- السعر -->
    <div class="col-12 col-md-4">
        <label asp-for="Price" class="form-label fw-semibold">السعر الأساسي (ج.م)</label>
        <div class="input-group">
            <input asp-for="Price" class="form-control fw-bold text-dark" type="number" step="0.01" placeholder="0.00" />
            <span class="input-group-text text-muted">ج.م</span>
        </div>
        <span asp-validation-for="Price" class="text-danger extra-small"></span>
    </div>

    <!-- وحدة البيع -->
    <div class="col-12 col-md-4">
        <label asp-for="SaleUnit" class="form-label fw-semibold">وحدة البيع</label>
        <select asp-for="SaleUnit" class="form-select"
                asp-items="Html.GetEnumSelectList<Awlad_Zamzam.MVC.Models.Enums.SaleUnit>()"></select>
        <span asp-validation-for="SaleUnit" class="text-danger extra-small"></span>
        <div class="form-text extra-small text-muted"><i class="fa-solid fa-circle-info me-1"></i>الكيلو للأصناف الطازجة، والقطعة للوجبات والعلب</div>
    </div>

    <!-- نسبة الخصم -->
    <div class="col-12 col-md-4">
        <label asp-for="DiscountPercentage" class="form-label fw-semibold">نسبة الخصم (%)</label>
        <div class="input-group">
            <input asp-for="DiscountPercentage" class="form-control fw-bold text-danger" type="number" min="0" max="100" placeholder="0" />
            <span class="input-group-text text-muted">%</span>
        </div>
        <span asp-validation-for="DiscountPercentage" class="text-danger extra-small"></span>
    </div>

    <!-- مفتاح التوفر -->
    <div class="col-12 col-md-6 d-flex align-items-center pt-md-3">
        <div class="form-check form-switch bg-light p-2.5 rounded-3 border w-100 d-flex align-items-center justify-content-between px-3">
            <label asp-for="IsAvailable" class="form-check-label fw-semibold mb-0">توفر المنتج للطلب</label>
            <input asp-for="IsAvailable" class="form-check-input ms-0" type="checkbox" role="switch" />
        </div>
    </div>

    <!-- رفع الصورة -->
    <div class="col-12 col-md-6">
        <label asp-for="ImageFile" class="form-label fw-semibold">صورة المنتج</label>
        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
    </div>

    <!-- معاينة الصورة الحالية -->
    @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
    {
        <div class="col-12 pt-2">
            <label class="form-label d-block fw-semibold small text-muted">الصورة الحالية:</label>
            <div class="current-img-preview d-inline-block p-1 border rounded-3 bg-light">
                <img src="@Model.ExistingImagePath" class="rounded-2" alt="الصورة الحالية" />
            </div>
        </div>
    }
</div>

<!-- أزرار الإجراءات -->
<div class="mt-4 pt-3 border-top d-flex gap-2">
    <button type="submit" class="btn btn-brand px-5 py-2 rounded-3">
        <i class="fa-solid fa-floppy-disk me-1"></i> حفظ المنتج
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-3">إلغاء</a>
</div>