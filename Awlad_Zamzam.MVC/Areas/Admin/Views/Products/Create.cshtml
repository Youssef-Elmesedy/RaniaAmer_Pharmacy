@model ProductFormViewModel
@{
    ViewData["Title"] = "إضافة منتج";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-products.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">إضافة منتج جديد</h3>
        <p class="text-muted small mb-0">قم بتعبئة بيانات الصنف والسعر وتحديد وحدة البيع</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة للمنتجات
    </a>
</div>

<div class="card border-0 shadow-sm p-4 rounded-4">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @await Html.PartialAsync("_ProductForm", Model)
    </form>
</div>