@model List<Product>
@{
    ViewData["Title"] = "المنتجات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-products.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">المنتجات</h3>
    <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i> إضافة منتج</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>الصورة</th>
                    <th>الاسم</th>
                    <th>القسم</th>
                    <th>السعر</th>
                    <th>الخصم</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td><img src="@(product.ImagePath ?? "/images/seed/grills.svg")" style="width:60px;height:60px;object-fit:cover;border-radius:8px" /></td>
                        <td>@product.Name</td>
                        <td>@product.Category?.Name</td>
                        <td>
                            @product.Price.ToString("0.00") ج.م
                            <span class="badge bg-secondary-subtle text-dark">@(product.SaleUnit == Awlad_Zamzam.MVC.Models.Enums.SaleUnit.Kilogram ? "/ كجم" : "/ قطعة")</span>
                        </td>
                        <td>
                            @if (product.DiscountPercentage > 0)
                            {
                                <span class="badge badge-offer">@product.DiscountPercentage%</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (product.IsAvailable)
                            {
                                <span class="badge bg-success">متوفر</span>
                            }
                            else
                            {
                                <span class="badge badge-unavailable">غير متوفر</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="js-delete-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">لا توجد منتجات مضافة بعد</div>
}
