@model DataCleanupPageViewModel
@{
    ViewData["Title"] = "تنظيف البيانات";
    var totalAlerts = Model.TableCleanup.Count + (Model.InactiveCustomersCount > 0 ? 1 : 0);
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-4">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-4">@TempData["ErrorMessage"]</div>
}

<!-- ترويسة الصفحة -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="admin-page-title mb-0">تنظيف البيانات</h3>
            @if (totalAlerts > 0)
            {
                <span class="badge bg-warning text-dark rounded-pill px-2.5 py-1 fs-6">@totalAlerts</span>
            }
        </div>
        <p class="text-muted small mb-0">مراجعات تحتاج موافقتك: جداول كبرت كثيرًا، وعملاء توقفوا عن التفاعل مع الموقع</p>
    </div>
</div>

@if (totalAlerts == 0)
{
    <div class="card border-0 shadow-sm p-5 text-center my-4 rounded-4">
        <div class="py-4">
            <i class="fa-solid fa-database text-muted fs-1 mb-3 d-block"></i>
            <h5 class="fw-bold text-dark mb-1">لا يوجد ما يحتاج مراجعتك الآن</h5>
            <p class="text-muted small mb-0">ستظهر هنا أي جداول كبرت كثيرًا أو عملاء غير نشطين فور توفر أي منهم.</p>
        </div>
    </div>
}

<!-- ============ العملاء غير النشطين ============ -->
@if (Model.InactiveCustomersCount > 0)
{
    <div class="card border-0 shadow-sm p-4 mb-4 rounded-4">
        <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;">
                <i class="fa-solid fa-user-clock fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-1">@Model.InactiveCustomersCount.ToString("N0") عميل غير نشط منذ أكثر من @Model.InactivityThresholdMonths أشهر</h5>
                <p class="text-muted small mb-0">
                    هؤلاء العملاء لم يطلبوا ولم يسجّلوا دخول منذ @Model.InactivityThresholdMonths أشهر على الأقل.
                    إيقافهم لا يحذف بياناتهم أو طلباتهم القديمة، ويمكن إعادة تفعيل أي واحد منهم في أي وقت من صفحة تفاصيله.
                </p>
            </div>
        </div>

        <div class="table-responsive rounded-3 border mb-3">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الاسم</th>
                        <th>الهاتف</th>
                        <th>آخر نشاط</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model.InactiveCustomersPreview)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@customer.Id" class="text-decoration-none">
                                    @customer.Name
                                </a>
                            </td>
                            <td class="dir-ltr">@customer.PhoneNumber</td>
                            <td class="small text-muted">
                                @(customer.LastActivityAt.HasValue
                                    ? customer.LastActivityAt.Value.ToEgyptTime().ToString("yyyy-MM-dd")
                                    : "لم يتفاعل أبدًا")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.InactiveCustomersCount > Model.InactiveCustomersPreview.Count)
        {
            <p class="text-muted small mb-3">
                ...وعدد @((Model.InactiveCustomersCount - Model.InactiveCustomersPreview.Count).ToString("N0")) عميل آخر غير معروض هنا.
            </p>
        }

        <form asp-action="DeactivateInactiveCustomers" method="post"
              onsubmit="return confirm('هل تريد إيقاف كل العملاء غير النشطين المعروضين؟ يمكن إعادة تفعيل أي عميل لاحقًا.');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-info text-white">
                <i class="fa-solid fa-pause me-1"></i> موافقة وإيقاف كل العملاء غير النشطين
            </button>
        </form>
    </div>
}

<!-- ============ الجداول الكبيرة ============ -->
@foreach (var item in Model.TableCleanup)
{
    <div class="card border-0 shadow-sm p-4 mb-4 rounded-4">
        <div class="d-flex align-items-start gap-3 mb-3">
            <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center flex-shrink-0" style="width:52px;height:52px;">
                <i class="fa-solid fa-triangle-exclamation fs-4"></i>
            </div>
            <div>
                <h5 class="fw-bold text-dark mb-1">جدول "@item.DisplayName" وصل إلى @item.TotalCount.ToString("N0") صف</h5>
                <p class="text-muted small mb-0">
                    الحد المسموح به قبل التنبيه هو @item.Threshold.ToString("N0") صف.
                    هذا يبطئ أداء الموقع تدريجيًا مع الوقت — ننصح بحذف أقدم البيانات الآمن حذفها.
                </p>
            </div>
        </div>

        @if (item.EligibleCount <= 0)
        {
            <div class="alert alert-secondary border-0 rounded-3 mb-0">
                <i class="fa-solid fa-circle-info me-1"></i>
                لا يوجد حاليًا أي عنصر آمن للحذف ضمن الأقدم @item.MaxDeleteCap.ToString("N0") — على الأرجح لأن أغلبها طلبات آجل لم تُسدد بعد أو لا تزال قيد المعالجة.
            </div>
        }
        else
        {
            <div class="alert alert-light border rounded-3 mb-3">
                <i class="fa-solid fa-circle-check text-success me-1"></i>
                يمكنك حذف حتى <strong>@item.EligibleCount.ToString("N0")</strong> طلب بأمان (من أقدم @item.MaxDeleteCap.ToString("N0") طلب تم فحصها) —
                وهي طلبات مكتملة ومسددة بالكامل فقط. لن يتم المساس بأي طلب لسه معلّق أو عليه مبلغ آجل غير مسدد.
            </div>

            <form asp-action="Delete" method="post"
                  onsubmit="return confirm('هل أنت متأكد من حذف العدد المحدد من أقدم بيانات (@item.DisplayName)؟ لا يمكن التراجع عن هذا الإجراء.');"
                  class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="key" value="@item.Key" />

                <div class="col-12 col-sm-5 col-md-4">
                    <label class="form-label fw-semibold small">عدد العناصر المراد حذفها</label>
                    <input type="number" name="count" class="form-control" min="1" max="@item.EligibleCount" value="@item.EligibleCount" required />
                    <div class="form-text">الحد الأقصى المسموح به الآن: @item.EligibleCount.ToString("N0")</div>
                </div>

                <div class="col-12 col-sm-4 col-md-3">
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa-solid fa-broom me-1"></i> موافقة وحذف
                    </button>
                </div>
            </form>
        }
    </div>
}
