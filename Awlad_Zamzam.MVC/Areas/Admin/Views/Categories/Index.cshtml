@model List<CategoryViewModel>
@{
    ViewData["Title"] = "الأقسام";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-categories.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">إدارة الأقسام</h3>
        <p class="text-muted small mb-0">عرض وإدارة جميع أقسام المنتجات المتاحة في المتجر</p>
    </div>
    <a asp-action="Create" class="btn btn-brand text-nowrap">
        <i class="fa-solid fa-plus me-1"></i> إضافة قسم جديد
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var category in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <div class="card category-card h-100 border-0 shadow-sm overflow-hidden">
                    <div class="card-img-wrapper position-relative overflow-hidden">
                        <img src="@(string.IsNullOrEmpty(category.Image) ? "/images/default-category.png" : category.Image)"
                             class="card-img-top category-img"
                             alt="@category.Name"
                             loading="lazy" />
                        <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-3 rounded-pill px-3 py-2 fs-7 fw-semibold">
                            <i class="fa-solid fa-box me-1 text-warning"></i> @category.ProductsCount منتج
                        </span>
                    </div>
                    <div class="card-body d-flex flex-column justify-content-between p-3">
                        <h5 class="fw-bold text-dark text-truncate mb-3" title="@category.Name">
                            @category.Name
                        </h5>

                        <div class="d-flex gap-2 pt-2 border-top">
                            <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary flex-grow-1">
                                <i class="fa-solid fa-pen me-1"></i> تعديل
                            </a>
                            <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="js-delete-form flex-grow-1">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                    <i class="fa-solid fa-trash me-1"></i> حذف
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="py-4">
            <div class="feature-icon mb-3 mx-auto">
                <i class="fa-solid fa-tags text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">لا توجد أقسام مضافة بعد</h5>
            <p class="text-muted mb-4">يمكنك البدء بإنشاء أول قسم لترتيب المنتجات داخل المتجر.</p>
            <a asp-action="Create" class="btn btn-brand px-4">
                <i class="fa-solid fa-plus me-1"></i> إضافة قسم الآن
            </a>
        </div>
    </div>
}