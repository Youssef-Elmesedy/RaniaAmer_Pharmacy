@model CategoryFormViewModel

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ExistingImage" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="ImageFile" class="form-label"></label>
        <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ExistingImage))
    {
        <div class="col-md-6">
            <label class="form-label d-block">الصورة الحالية</label>
            <img src="@Model.ExistingImage" style="width:100px;height:100px;object-fit:cover;border-radius:8px" />
        </div>
    }
</div>

<div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-brand px-5"><i class="fa-solid fa-floppy-disk me-1"></i> حفظ</button>
    <a asp-action="Index" class="btn btn-outline-secondary px-5">إلغاء</a>
</div>
