@model List<OfferViewModel>
@{
    ViewData["Title"] = "العروض";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-offers.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">العروض</h3>
    <a asp-action="Create" class="btn btn-brand"><i class="fa-solid fa-plus me-1"></i> إضافة عرض</a>
</div>

<div class="row g-4">
    @foreach (var offer in Model)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-3">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="fw-bold mb-1">@offer.Title</h5>
                        <p class="text-muted small mb-2">@offer.Description</p>
                    </div>
                    @if (offer.IsActive)
                    {
                        <span class="badge bg-success">مفعّل</span>
                    }
                    else
                    {
                        <span class="badge badge-unavailable">غير مفعّل</span>
                    }
                </div>

                <div class="d-flex flex-wrap gap-2 mb-3">
                    @foreach (var item in offer.Items)
                    {
                        <span class="badge bg-secondary-subtle text-dark">@item.ProductName (@item.SpecialPrice.ToString("0.00"))</span>
                    }
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@offer.Id" class="btn btn-sm btn-outline-secondary flex-grow-1">
                        <i class="fa-solid fa-pen me-1"></i> تعديل
                    </a>
                    <form asp-action="ToggleActive" asp-route-id="@offer.Id" method="post" class="flex-grow-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-primary w-100">
                            @(offer.IsActive ? "إيقاف" : "تفعيل")
                        </button>
                    </form>
                    <form asp-action="Delete" asp-route-id="@offer.Id" method="post" class="js-delete-form flex-grow-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                            <i class="fa-solid fa-trash me-1"></i> حذف
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">لا توجد عروض مضافة بعد</div>
}
