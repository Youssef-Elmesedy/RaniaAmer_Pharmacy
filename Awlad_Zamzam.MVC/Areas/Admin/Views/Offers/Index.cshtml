@model List<OfferViewModel>
@{
    ViewData["Title"] = "إدارة العروض";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-offers.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">العروض والخصومات</h3>
        <p class="text-muted small mb-0">إدارة قوائم العروض والتخفيضات المتاحة للعملاء</p>
    </div>
    <a asp-action="Create" class="btn btn-brand">
        <i class="fa-solid fa-plus me-1"></i> إضافة عرض جديد
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var offer in Model)
        {
            <div class="col-12 col-md-6">
                <div class="card offer-card border-0 shadow-sm p-4 rounded-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <!-- الترويسة والحالة -->
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <h5 class="fw-bold text-dark mb-0">@offer.Title</h5>
                            @if (offer.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">مفعّل</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-3 py-1">غير مفعّل</span>
                            }
                        </div>

                        <p class="text-muted small mb-3 text-truncate-2">
                            @(string.IsNullOrWhiteSpace(offer.Description) ? "لا يوجد وصف محدد لهذا العرض." : offer.Description)
                        </p>

                        <!-- قائمة المنتجات المشاركة -->
                        <div class="offer-items-wrap p-3 rounded-3 mb-3">
                            <div class="text-muted extra-small mb-2 fw-bold">المنتجات في العرض:</div>
                            <div class="d-flex flex-wrap gap-1.5">
                                @foreach (var item in offer.Items)
                                {
                                    <span class="badge bg-white text-dark border shadow-sm px-2.5 py-1.5 fw-normal">
                                        @item.ProductName
                                        <span class="fw-bold text-danger ms-1">@item.SpecialPrice.ToString("N2") ج.م</span>
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- أزرار العمليات -->
                    <div class="d-flex gap-2 pt-2 border-top">
                        <a asp-action="Edit" asp-route-id="@offer.Id" class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-3">
                            <i class="fa-solid fa-pen me-1"></i> تعديل
                        </a>

                        <form asp-action="ToggleActive" asp-route-id="@offer.Id" method="post" class="flex-grow-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm @(offer.IsActive ? "btn-outline-warning" : "btn-outline-success") w-100 rounded-3">
                                @(offer.IsActive ? "إيقاف" : "تفعيل")
                            </button>
                        </form>

                        <form asp-action="Delete" asp-route-id="@offer.Id" method="post" class="js-delete-form flex-grow-1">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger w-100 rounded-3">
                                <i class="fa-solid fa-trash me-1"></i> حذف
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-4 rounded-4">
        <div class="py-4">
            <div class="offer-empty-icon mb-3 mx-auto">
                <i class="fa-solid fa-percent text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">لا توجد عروض مضافة بعد</h5>
            <p class="text-muted small mb-3">يمكنك إضافة عروض وتخفيضات جديدة لجذب العملاء وزيادة المبيعات.</p>
            <a asp-action="Create" class="btn btn-brand btn-sm px-4">
                <i class="fa-solid fa-plus me-1"></i> إضافة أول عرض
            </a>
        </div>
    </div>
}