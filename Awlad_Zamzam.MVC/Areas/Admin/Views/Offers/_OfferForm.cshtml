@model OfferFormViewModel

<input type="hidden" asp-for="Id" />

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3 mb-3">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check form-switch mt-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

<label class="form-label fw-bold">اختر المنتجات وحدد سعر كل منتج داخل العرض</label>
<span asp-validation-for="SelectedProductIds" class="text-danger d-block mb-2"></span>

<div class="row g-2">
    @foreach (var product in Model.AllProducts)
    {
        var isChecked = Model.SelectedProductIds.Contains(product.Id);
        var specialPrice = Model.SpecialPrices.GetValueOrDefault(product.Id, product.Price);

        <div class="col-md-6">
            <div class="border rounded-3 p-2 d-flex align-items-center gap-2">
                @if (isChecked)
                {
                    <input type="checkbox" class="form-check-input offer-product-check" name="SelectedProductIds" value="@product.Id" checked />
                }
                else
                {
                    <input type="checkbox" class="form-check-input offer-product-check" name="SelectedProductIds" value="@product.Id" />
                }
                <img src="@(product.ImagePath ?? "/images/seed/grills.svg")" style="width:45px;height:45px;object-fit:cover;border-radius:6px" />
                <div class="flex-grow-1">
                    <div class="small fw-bold">@product.Name</div>
                    <div class="small text-muted">السعر الأصلي: @product.Price.ToString("0.00")</div>
                </div>
                <input type="number" step="0.01" class="form-control form-control-sm" style="width:100px"
                       name="SpecialPrice_@product.Id" value="@specialPrice.ToString("0.00")" placeholder="سعر العرض" />
            </div>
        </div>
    }
</div>

<div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-brand px-5"><i class="fa-solid fa-floppy-disk me-1"></i> حفظ</button>
    <a asp-action="Index" class="btn btn-outline-secondary px-5">إلغاء</a>
</div>
