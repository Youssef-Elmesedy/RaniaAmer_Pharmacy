@model List<OrderListItemViewModel>
@{
    ViewData["Title"] = "الطلبات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-orders.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">الطلبات</h3>
    <a asp-action="Create" class="btn btn-brand">
        <i class="fa-solid fa-plus me-1"></i> تسجيل طلب آجل لعميل
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>العميل</th>
                    <th>الهاتف</th>
                    <th>النوع</th>
                    <th>عدد الأصناف</th>
                    <th>الإجمالي</th>
                    <th>التاريخ</th>
                    <th>الحالة</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.CustomerName</td>
                        <td>@order.CustomerPhone</td>
                        <td>
                            @if (order.IsCredit)
                            {
                                <span class="badge bg-warning text-dark">آجل</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">فوري</span>
                            }
                        </td>
                        <td>@order.ItemsCount</td>
                        <td class="fw-bold">
                            @order.Total.ToString("0.00") ج.م
                            @if (order.Status == OrderStatus.Completed && order.IsCredit && !order.IsFullyPaid)
                            {
                                <div class="small text-danger">متبقي @order.RemainingBalance.ToString("0.00")</div>
                            }
                        </td>
                        <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (order.Status == OrderStatus.Pending)
                            {
                                <span class="badge bg-danger">قيد الانتظار</span>
                            }
                            else
                            {
                                <span class="badge bg-success">تم التنفيذ</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <div class="btn-group">
                                        <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle" data-bs-toggle="dropdown">
                                            <i class="fa-solid fa-check"></i> تسليم
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <form asp-action="Complete" asp-route-id="@order.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="isCredit" value="false" />
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="fa-solid fa-money-bill me-1"></i> تسليم كاش
                                                    </button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="Complete" asp-route-id="@order.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="isCredit" value="true" />
                                                    <button type="submit" class="dropdown-item">
                                                        <i class="fa-solid fa-clock me-1"></i> تسليم آجل
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                else if (!order.IsCredit || order.IsFullyPaid)
                                {
                                    <form asp-action="Delete" asp-route-id="@order.Id" method="post" class="js-delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="مسح الطلب">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark align-self-center">آجل غير مسدد</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">لا توجد طلبات بعد</div>
}
