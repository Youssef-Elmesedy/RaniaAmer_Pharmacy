@model List<OrderListItemViewModel>
@{
    ViewData["Title"] = "الطلبات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-orders.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">إدارة الطلبات</h3>
        <p class="text-muted small mb-0">عرض ومتابعة حالة طلبات الكاش والآجل وإدارة التسليم</p>
    </div>
    <a asp-action="Create" class="btn btn-brand">
        <i class="fa-solid fa-plus me-1"></i> تسجيل طلب آجل لعميل
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>العميل</th>
                        <th>الهاتف</th>
                        <th>النوع</th>
                        <th>الأصناف</th>
                        <th>الإجمالي</th>
                        <th>التاريخ</th>
                        <th>الحالة</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@order.CustomerName</td>
                            <td>
                                <a href="tel:@order.CustomerPhone" class="text-decoration-none text-secondary dir-ltr d-inline-block">
                                    <i class="fa-solid fa-phone me-1 small text-muted"></i>@order.CustomerPhone
                                </a>
                            </td>
                            <td>
                                @if (order.IsCredit)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>آجل</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border"><i class="fa-solid fa-money-bill me-1"></i>فوري</span>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@order.ItemsCount صنف</span></td>
                            <td>
                                <div class="fw-bold text-dark">@order.Total.ToString("N2") ج.م</div>
                                @if (order.Status == OrderStatus.Completed && order.IsCredit && !order.IsFullyPaid)
                                {
                                    <div class="extra-small text-danger fw-semibold">متبقي @order.RemainingBalance.ToString("N2") ج.م</div>
                                }
                            </td>
                            <td>
                                <span class="d-block fw-semibold text-dark small">@order.OrderDate.ToString("yyyy-MM-dd")</span>
                                <span class="text-muted extra-small">@order.OrderDate.ToString("hh:mm tt")</span>
                            </td>
                            <td>
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">قيد الانتظار</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">تم التنفيذ</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1.5">
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="عرض التفاصيل">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    @if (order.Status == OrderStatus.Pending)
                                    {
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-success dropdown-toggle rounded-3" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fa-solid fa-check me-1"></i> تسليم
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-3">
                                                <li>
                                                    <form asp-action="Complete" asp-route-id="@order.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="isCredit" value="false" />
                                                        <button type="submit" class="dropdown-item py-2">
                                                            <i class="fa-solid fa-money-bill text-success me-2"></i> تسليم كاش
                                                        </button>
                                                    </form>
                                                </li>
                                                <li>
                                                    <form asp-action="Complete" asp-route-id="@order.Id" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="isCredit" value="true" />
                                                        <button type="submit" class="dropdown-item py-2">
                                                            <i class="fa-solid fa-clock text-warning me-2"></i> تسليم آجل
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    }
                                    else if (!order.IsCredit || order.IsFullyPaid)
                                    {
                                        <form asp-action="Delete" asp-route-id="@order.Id" method="post" class="js-delete-form">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="حذف الطلب">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-dark border border-warning extra-small py-1.5">آجل غير مسدد</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-4 rounded-4">
        <div class="py-4">
            <div class="order-empty-icon mb-3 mx-auto">
                <i class="fa-solid fa-receipt text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">لا توجد طلبات مسجلة</h5>
            <p class="text-muted small mb-3">يمكنك تسجيل طلب آجل جديد أو استقبال طلبات العملاء المباشرة.</p>
            <a asp-action="Create" class="btn btn-brand btn-sm px-4">
                <i class="fa-solid fa-plus me-1"></i> تسجيل طلب جديد
            </a>
        </div>
    </div>
}