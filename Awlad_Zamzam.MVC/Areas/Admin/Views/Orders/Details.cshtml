@model OrderDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الطلب";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-orders.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">تفاصيل الطلب #@Model.Id</h3>
        <p class="text-muted small mb-0">مراجعة أصناف الطلب وقوائم التسليم والآجل</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> العودة للطلبات
    </a>
</div>

<div class="row g-4">
    <!-- بيانات العميل والعمليات -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="fa-solid fa-user me-2 text-danger"></i>بيانات العميل
            </h5>

            <div class="d-flex flex-column gap-2.5 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-user-tag text-muted width-20"></i>
                    <span class="fw-bold text-dark">@Model.CustomerName</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-solid fa-phone text-muted width-20"></i>
                    <a href="tel:@Model.CustomerPhone" class="text-decoration-none text-dark dir-ltr fw-semibold">@Model.CustomerPhone</a>
                </div>
                <div class="d-flex align-items-start gap-2">
                    <i class="fa-solid fa-location-dot text-muted width-20 mt-1"></i>
                    <span class="text-muted small">@(string.IsNullOrWhiteSpace(Model.CustomerAddress) ? "غير محدد" : Model.CustomerAddress)</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-regular fa-calendar text-muted width-20"></i>
                    <span class="text-muted small">@Model.OrderDate.ToEgyptTime().ToString("yyyy-MM-dd hh:mm tt")</span>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                @if (Model.IsCredit)
                {
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>طلب آجل</span>
                }
                else
                {
                    <span class="badge bg-secondary"><i class="fa-solid fa-money-bill me-1"></i>طلب فوري</span>
                }

                @if (Model.Status == OrderStatus.Pending)
                {
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">قيد الانتظار</span>
                }
                else
                {
                    <span class="badge bg-success">تم التنفيذ</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="alert alert-light border rounded-3 mt-3 mb-0 small">
                    <strong class="d-block text-dark mb-1"><i class="fa-regular fa-comment-dots me-1"></i>ملاحظات:</strong>
                    @Model.Notes
                </div>
            }
        </div>

        <!-- أزرار الإجراءات -->
        <div class="d-flex gap-2">
            @if (Model.Status == OrderStatus.Pending)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="flex-grow-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isCredit" value="false" />
                    <button type="submit" class="btn btn-success w-100 rounded-3 py-2 fw-semibold">
                        <i class="fa-solid fa-money-bill me-1"></i> تسليم كاش
                    </button>
                </form>
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="flex-grow-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isCredit" value="true" />
                    <button type="submit" class="btn btn-warning w-100 rounded-3 py-2 fw-semibold">
                        <i class="fa-solid fa-clock me-1"></i> تسليم آجل
                    </button>
                </form>
            }
            else if (!Model.IsCredit || Model.IsFullyPaid)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="js-delete-form flex-grow-1">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger w-100 rounded-3 py-2">
                        <i class="fa-solid fa-trash me-1"></i> مسح الطلب
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-warning w-100 mb-0 text-center rounded-3 small">
                    <i class="fa-solid fa-lock me-1"></i> لا يمكن حذف طلب آجل غير مسدد بالكامل
                </div>
            }
        </div>
    </div>

    <!-- قائمة الأصناف والمدفوعات -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="p-3 bg-light border-bottom">
                <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-basket-shopping me-2 text-danger"></i>أصناف الطلب</h6>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>المنتج</th>
                            <th>السعر</th>
                            <th>الكمية</th>
                            <th>الإجمالي</th>
                            <th>ملاحظة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@item.ProductName</td>
                                <td>@item.UnitPrice.ToString("N2") ج.م / @item.UnitLabel</td>
                                <td><span class="badge bg-light text-dark border">@item.Quantity.ToString("0.##") @item.UnitLabel</span></td>
                                <td class="fw-bold text-dark">@item.LineTotal.ToString("N2") ج.م</td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(item.Note) ? "-" : item.Note)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">الإجمالي الكلي</td>
                            <td class="fw-bold fs-5 text-danger">@Model.Total.ToString("N2") ج.م</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- سجل الدفعات الآجلة -->
        @if (Model.IsCredit && Model.Status == OrderStatus.Completed)
        {
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h6 class="fw-bold text-dark mb-0"><i class="fa-solid fa-money-bill-wave me-2 text-success"></i>سجل دفعات الآجل</h6>
                    <div class="text-end">
                        <span class="small text-muted d-block">المدفوع: <span class="fw-bold text-success">@Model.AmountPaid.ToString("N2") ج.م</span></span>
                        <span class="fw-bold @(Model.IsFullyPaid ? "text-success" : "text-danger")">
                            المتبقي: @Model.RemainingBalance.ToString("N2") ج.م
                        </span>
                    </div>
                </div>

                @if (Model.Payments.Any())
                {
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>التاريخ والوقت</th>
                                    <th>المبلغ</th>
                                    <th>ملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in Model.Payments)
                                {
                                    <tr>
                                        <td class="small">@payment.PaidAt.ToEgyptTime().ToString("yyyy-MM-dd hh:mm tt")</td>
                                        <td class="fw-bold text-success">@payment.Amount.ToString("N2") ج.م</td>
                                        <td class="text-muted small">@(string.IsNullOrWhiteSpace(payment.Notes) ? "-" : payment.Notes)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-3">لم يتم تسجيل أي دفعات نقداً لهذا الطلب بعد.</p>
                }

                @if (!Model.IsFullyPaid)
                {
                    <form asp-action="Pay" asp-route-id="@Model.Id" method="post" class="row g-2 pt-2 border-top">
                        @Html.AntiForgeryToken()
                        <div class="col-12 col-md-4">
                            <input type="number" name="amount" step="0.01" min="0.01" max="@Model.RemainingBalance"
                                   class="form-control" placeholder="المبلغ المدفوع (ج.م)" required />
                        </div>
                        <div class="col-12 col-md-5">
                            <input type="text" name="notes" class="form-control" placeholder="ملاحظات الدفعة (اختياري)" />
                        </div>
                        <div class="col-12 col-md-3">
                            <button type="submit" class="btn btn-brand w-100">
                                <i class="fa-solid fa-plus me-1"></i> تسجيل دفعة
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-success mb-0 text-center rounded-3 py-2">
                        <i class="fa-solid fa-circle-check me-1"></i> تم سداد الطلب بالكامل
                    </div>
                }
            </div>
        }
    </div>
</div>