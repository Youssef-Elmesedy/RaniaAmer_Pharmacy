@model OrderDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الطلب";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-orders.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">تفاصيل الطلب</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> رجوع
    </a>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-4">
            <h5 class="fw-bold mb-3">بيانات العميل</h5>
            <p class="mb-2"><i class="fa-solid fa-user me-2"></i>@Model.CustomerName</p>
            <p class="mb-2"><i class="fa-solid fa-phone me-2"></i>@Model.CustomerPhone</p>
            <p class="mb-2"><i class="fa-solid fa-location-dot me-2"></i>@Model.CustomerAddress</p>
            <p class="mb-2"><i class="fa-solid fa-calendar me-2"></i>@Model.OrderDate.ToString("yyyy-MM-dd HH:mm")</p>
            <p class="mb-2">
                @if (Model.IsCredit)
                {
                    <span class="badge bg-warning text-dark">طلب آجل</span>
                }
                else
                {
                    <span class="badge bg-secondary">طلب فوري</span>
                }
                @if (Model.Status == OrderStatus.Pending)
                {
                    <span class="badge bg-danger">قيد الانتظار</span>
                }
                else
                {
                    <span class="badge bg-success">تم التنفيذ</span>
                }
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="alert alert-light border mt-3 mb-0">
                    <strong>ملاحظات:</strong> @Model.Notes
                </div>
            }
        </div>

        <div class="mt-3 d-flex gap-2">
            @if (Model.Status == OrderStatus.Pending)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="flex-grow-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isCredit" value="false" />
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fa-solid fa-money-bill me-1"></i> تسليم كاش
                    </button>
                </form>
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="flex-grow-1">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="isCredit" value="true" />
                    <button type="submit" class="btn btn-warning w-100">
                        <i class="fa-solid fa-clock me-1"></i> تسليم آجل
                    </button>
                </form>
            }
            else if (!Model.IsCredit || Model.IsFullyPaid)
            {
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="js-delete-form flex-grow-1">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa-solid fa-trash me-1"></i> مسح الطلب
                    </button>
                </form>
            }
            else
            {
                <div class="alert alert-warning w-100 mb-0 text-center">
                    <i class="fa-solid fa-lock me-1"></i> لا يمكن حذف طلب آجل غير مسدد بالكامل
                </div>
            }
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>المنتج</th>
                            <th>السعر</th>
                            <th>الكمية</th>
                            <th>الإجمالي</th>
                            <th>ملاحظة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>@item.ProductName</td>
                                <td>@item.UnitPrice.ToString("0.00") ج.م</td>
                                <td>@item.Quantity</td>
                                <td class="fw-bold">@item.LineTotal.ToString("0.00") ج.م</td>
                                <td class="text-muted small">@item.Note</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="3" class="text-end fw-bold">الإجمالي الكلي</td>
                            <td class="fw-bold price-new">@Model.Total.ToString("0.00") ج.م</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        @if (Model.IsCredit && Model.Status == OrderStatus.Completed)
        {
            <div class="card border-0 shadow-sm p-4 mt-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="fa-solid fa-money-bill-wave me-2"></i>سجل الدفعات (آجل)</h5>
                    <div class="text-end">
                        <div class="small text-muted">المدفوع: @Model.AmountPaid.ToString("0.00") ج.م</div>
                        <div class="fw-bold @(Model.IsFullyPaid ? "text-success" : "text-danger")">
                            المتبقي: @Model.RemainingBalance.ToString("0.00") ج.م
                        </div>
                    </div>
                </div>

                @if (Model.Payments.Any())
                {
                    <div class="table-responsive">
                    <table class="table table-sm mb-3">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>المبلغ</th>
                                <th>ملاحظة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.Payments)
                            {
                                <tr>
                                    <td>@payment.PaidAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td class="fw-bold">@payment.Amount.ToString("0.00") ج.م</td>
                                    <td class="text-muted small">@payment.Notes</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-3">لا توجد دفعات مسجلة بعد</p>
                }

                @if (!Model.IsFullyPaid)
                {
                    <form asp-action="Pay" asp-route-id="@Model.Id" method="post" class="row g-2">
                        @Html.AntiForgeryToken()
                        <div class="col-md-4">
                            <input type="number" name="amount" step="0.01" min="0.01" max="@Model.RemainingBalance"
                                   class="form-control" placeholder="المبلغ المدفوع" required />
                        </div>
                        <div class="col-md-5">
                            <input type="text" name="notes" class="form-control" placeholder="ملاحظة (اختياري)" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-brand w-100">
                                <i class="fa-solid fa-plus me-1"></i> تسجيل دفعة
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-success mb-0 text-center">
                        <i class="fa-solid fa-circle-check me-1"></i> تم سداد الطلب بالكامل
                    </div>
                }
            </div>
        }
    </div>
</div>
