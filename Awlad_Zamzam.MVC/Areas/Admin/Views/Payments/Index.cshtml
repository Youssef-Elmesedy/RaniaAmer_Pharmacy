@model PaymentPageViewModel
@{
    ViewData["Title"] = "صفحة الدفع";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-payments.css" asp-append-version="true" />
}

<h3 class="fw-bold mb-4"><i class="fa-solid fa-money-bill-wave me-2"></i>صفحة الدفع (آجل)</h3>

<div class="card border-0 shadow-sm p-4 mb-4 payments-search-card">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">بحث بالاسم أو رقم الهاتف</label>
            <input type="text" name="search" value="@Model.SearchTerm" class="form-control js-live-search"
                   placeholder="اكتب اسم العميل أو رقمه..." autocomplete="off" />
        </div>
        <div class="col-md-5">
            <label class="form-label">اختر العميل</label>
            <select name="customerId" class="form-select" onchange="this.form.submit()">
                <option value="">-- اختر عميل له طلبات آجل --</option>
                @foreach (var customer in Model.Customers.Where(c => c.TotalCreditDue > 0))
                {
                    if (customer.Id == Model.SelectedCustomerId)
                    {
                        <option value="@customer.Id" selected>
                            @customer.Name - @customer.PhoneNumber (متبقي @customer.TotalCreditDue.ToString("0.00"))
                        </option>
                    }
                    else
                    {
                        <option value="@customer.Id">
                            @customer.Name - @customer.PhoneNumber (متبقي @customer.TotalCreditDue.ToString("0.00"))
                        </option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-brand w-100"><i class="fa-solid fa-magnifying-glass"></i> بحث</button>
        </div>
    </form>

    @if (Model.SearchTerm != null && Model.Customers.Any())
    {
        <div class="mt-3">
            <div class="small text-muted mb-1">نتائج البحث:</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var customer in Model.Customers)
                {
                    <a asp-action="Index" asp-route-customerId="@customer.Id" asp-route-search="@Model.SearchTerm"
                       class="btn btn-sm @(customer.Id == Model.SelectedCustomerId ? "btn-brand" : "btn-outline-secondary")">
                        @customer.Name - @customer.PhoneNumber
                        @if (customer.TotalCreditDue > 0)
                        {
                            <span class="badge bg-danger ms-1">@customer.TotalCreditDue.ToString("0.00")</span>
                        }
                    </a>
                }
            </div>
        </div>
    }
</div>

@if (Model.SelectedCustomerId != null)
{
    <div class="card border-0 shadow-sm p-4 mb-4 payment-summary-card">
        <h5 class="fw-bold mb-3">
            <i class="fa-solid fa-circle-user me-2"></i>@Model.SelectedCustomerName - @Model.SelectedCustomerPhone
        </h5>

        @if (!Model.CreditOrders.Any())
        {
            <p class="text-muted mb-0">لا توجد طلبات آجل لهذا العميل</p>
        }
        else
        {
            <div class="row g-3 mb-4 text-center">
                <div class="col-md-4">
                    <div class="payment-stat">
                        <div class="small text-muted">إجمالي طلبات الآجل</div>
                        <div class="fw-bold fs-5">@Model.TotalOrdersAmount.ToString("0.00") ج.م</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="payment-stat">
                        <div class="small text-muted">مدفوع سابقاً</div>
                        <div class="fw-bold fs-5 text-success">@Model.TotalPaidSoFar.ToString("0.00") ج.م</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="payment-stat payment-stat-due">
                        <div class="small text-muted">إجمالي المتبقي (كل الطلبات)</div>
                        <div class="fw-bold fs-4 text-danger">@Model.TotalDue.ToString("0.00") ج.م</div>
                    </div>
                </div>
            </div>

            @if (Model.TotalDue > 0)
            {
                <form asp-action="Pay" method="post" class="row g-2 align-items-end payment-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="customerId" value="@Model.SelectedCustomerId" />
                    <div class="col-md-4">
                        <label class="form-label">المبلغ المدفوع</label>
                        <input type="number" name="amount" step="0.01" min="0.01" max="@Model.TotalDue"
                               class="form-control" placeholder="اكتب المبلغ" required />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">ملاحظة (اختياري)</label>
                        <input type="text" name="notes" class="form-control" placeholder="مثال: دفعة نقدية" />
                    </div>
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-brand w-100">
                            <i class="fa-solid fa-plus me-1"></i> تسجيل الدفعة
                        </button>
                    </div>
                    <div class="col-12">
                        <div class="form-text">
                            <i class="fa-solid fa-circle-info me-1"></i>
                            المبلغ هيتوزع تلقائياً على أقدم الطلبات الآجلة أولاً حتى ينتهي.
                        </div>
                    </div>
                </form>
            }
            else
            {
                <div class="alert alert-success mb-0 text-center">
                    <i class="fa-solid fa-circle-check me-1"></i> تم سداد كل طلبات هذا العميل بالكامل
                </div>
            }

            <hr class="my-4" />

            <h6 class="fw-bold mb-3">تفاصيل الطلبات الآجلة</h6>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>التاريخ</th>
                            <th>الإجمالي</th>
                            <th>المدفوع</th>
                            <th>المتبقي</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.CreditOrders.OrderBy(o => o.OrderDate))
                        {
                            <tr class="@(order.IsFullyPaid ? "table-success" : "")">
                                <td>@order.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@order.Total.ToString("0.00") ج.م</td>
                                <td>@order.AmountPaid.ToString("0.00") ج.م</td>
                                <td class="fw-bold @(order.IsFullyPaid ? "text-success" : "text-danger")">
                                    @(order.IsFullyPaid ? "مسدد" : order.RemainingBalance.ToString("0.00") + " ج.م")
                                </td>
                                <td>
                                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="small">التفاصيل</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}
