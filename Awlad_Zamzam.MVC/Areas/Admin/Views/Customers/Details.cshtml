@model CustomerListItemViewModel
@{
    ViewData["Title"] = "بيانات العميل";
    var orders = ViewBag.Orders as List<OrderListItemViewModel> ?? new List<OrderListItemViewModel>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-customers.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="admin-page-title mb-1">@Model.Name</h3>
            @if (!Model.IsActive)
            {
                <span class="badge bg-secondary rounded-pill">
                    <i class="fa-solid fa-pause me-1"></i> موقوف لعدم النشاط
                </span>
            }
        </div>
        <p class="text-muted small mb-0">
            <i class="fa-solid fa-location-dot me-1 text-danger"></i>
            @(string.IsNullOrWhiteSpace(Model.Address) ? "لم يتم تحديد العنوان" : Model.Address)
        </p>
        @if (Model.LastActivityAt.HasValue)
        {
            <p class="text-muted small mb-0">
                <i class="fa-regular fa-clock me-1"></i>
                آخر نشاط: @Model.LastActivityAt.Value.ToEgyptTime().ToString("yyyy-MM-dd")
            </p>
        }
    </div>
    <div class="d-flex gap-2">
        @if (!Model.IsActive)
        {
            <form asp-action="Reactivate" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-success">
                    <i class="fa-solid fa-play me-1"></i> إعادة تفعيل
                </button>
            </form>
        }
        @if (Model.OrdersCount == 0)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="js-delete-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="fa-solid fa-trash me-1"></i> حذف العميل
                </button>
            </form>
        }
        else
        {
            <button type="button" class="btn btn-sm btn-outline-danger" disabled title="لا يمكن حذف عميل لديه طلبات مسجلة">
                <i class="fa-solid fa-trash me-1"></i> حذف العميل
            </button>
        }
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="fa-solid fa-arrow-right me-1"></i> العودة لقائمة العملاء
        </a>
    </div>
</div>

<!-- بطاقات الإحصائيات -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card p-3 border-0 shadow-sm h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="fa-solid fa-phone"></i>
                </div>
                <div>
                    <div class="text-muted small">رقم الهاتف</div>
                    <a href="tel:@Model.PhoneNumber" class="fw-bold text-dark text-decoration-none">@Model.PhoneNumber</a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card p-3 border-0 shadow-sm h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="fa-solid fa-basket-shopping"></i>
                </div>
                <div>
                    <div class="text-muted small">إجمالي الطلبات</div>
                    <div class="fw-bold fs-5 text-dark">@Model.OrdersCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card p-3 border-0 shadow-sm h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                </div>
                <div>
                    <div class="text-muted small">طلبات آجل</div>
                    <div class="fw-bold fs-5 text-dark">@Model.CreditOrdersCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card stat-card p-3 border-0 shadow-sm h-100">
            <div class="d-flex align-items-center gap-3">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                    <i class="fa-solid fa-money-bill-wave"></i>
                </div>
                <div>
                    <div class="text-muted small">المستحق (آجل)</div>
                    <div class="fw-bold fs-5 text-danger">@Model.TotalCreditDue.ToString("N2") ج.م</div>
                </div>
            </div>
        </div>
    </div>
</div>

<h5 class="fw-bold text-dark mb-3">سجل طلبات العميل</h5>

@if (orders.Any())
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>التاريخ والوقت</th>
                        <th>عدد الأصناف</th>
                        <th>الإجمالي</th>
                        <th>نوع الدفع</th>
                        <th>حالة الطلب</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr class="@(order.IsCredit && order.Status == OrderStatus.Completed ? "table-warning-subtle" : "")">
                            <td>
                                <span class="d-block fw-semibold text-dark">@order.OrderDate.ToEgyptTime().ToString("yyyy-MM-dd")</span>
                                <span class="text-muted small">@order.OrderDate.ToEgyptTime().ToString("hh:mm tt")</span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@order.ItemsCount صنف</span></td>
                            <td class="fw-bold text-dark">@order.Total.ToString("N2") ج.م</td>
                            <td>
                                @if (order.Status == OrderStatus.Completed && order.IsCredit)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i> آجل</span>
                                }
                                else if (order.Status == OrderStatus.Completed)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25"><i class="fa-solid fa-money-bill me-1"></i> كاش</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td>
                                @if (order.Status == OrderStatus.Pending)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25">قيد الانتظار</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">تم التسليم</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary" title="عرض التفاصيل">
                                    <i class="fa-solid fa-eye me-1"></i> التفاصيل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-3 rounded-4">
        <div class="py-3">
            <i class="fa-solid fa-receipt text-muted fs-1 mb-3"></i>
            <h6 class="fw-bold text-dark mb-1">لا توجد طلبات مسجلة لهذا العميل</h6>
            <p class="text-muted small mb-0">عند قيام العميل بإجراء أي طلبات ستظهر هنا تلقائياً.</p>
        </div>
    </div>
}