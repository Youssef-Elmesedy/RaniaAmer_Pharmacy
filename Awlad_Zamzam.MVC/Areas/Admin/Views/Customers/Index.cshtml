@model List<CustomerListItemViewModel>
@{
    ViewData["Title"] = "العملاء";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-customers.css" asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">العملاء</h3>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control js-live-search" placeholder="بحث بالاسم أو رقم الهاتف..." autocomplete="off" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-brand w-100"><i class="fa-solid fa-magnifying-glass"></i> بحث</button>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>الاسم</th>
                    <th>الهاتف</th>
                    <th>العنوان</th>
                    <th>حساب؟</th>
                    <th>عدد الطلبات</th>
                    <th>طلبات آجل</th>
                    <th>إجمالي المستحق</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>@customer.Name</td>
                        <td>@customer.PhoneNumber</td>
                        <td class="text-muted small">@customer.Address</td>
                        <td>
                            @if (customer.HasAccount)
                            {
                                <span class="badge bg-success">نعم</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">لا</span>
                            }
                        </td>
                        <td>@customer.OrdersCount</td>
                        <td>
                            @if (customer.CreditOrdersCount > 0)
                            {
                                <span class="badge bg-warning text-dark">@customer.CreditOrdersCount</span>
                            }
                            else
                            {
                                <span class="text-muted">0</span>
                            }
                        </td>
                        <td class="fw-bold @(customer.TotalCreditDue > 0 ? "price-new" : "")">
                            @customer.TotalCreditDue.ToString("0.00") ج.م
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="fa-solid fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">لا يوجد عملاء</div>
}
