@model List<CustomerListItemViewModel>
@{
    ViewData["Title"] = "العملاء";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-customers.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">قائمة العملاء</h3>
        <p class="text-muted small mb-0">عرض وحسابات جميع العملاء المسجلين وسجل مديونياتهم</p>
    </div>
</div>

<!-- نموذج البحث -->
<div class="card border-0 shadow-sm p-3 mb-4 rounded-4">
    <form method="get" class="row g-2">
        <div class="col-12 col-md-9 col-lg-10">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0 js-live-search" placeholder="بحث باسم العميل أو رقم الهاتف..." autocomplete="off" />
            </div>
        </div>
        <div class="col-12 col-md-3 col-lg-2">
            <button type="submit" class="btn btn-brand w-100">
                <i class="fa-solid fa-filter me-1"></i> بحث
            </button>
        </div>
    </form>
</div>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>الاسم</th>
                        <th>الهاتف</th>
                        <th>العنوان</th>
                        <th>حساب مسجل</th>
                        <th>عدد الطلبات</th>
                        <th>طلبات آجل</th>
                        <th>إجمالي المستحق</th>
                        <th class="text-end">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var customer in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@customer.Name</td>
                            <td>
                                <a href="tel:@customer.PhoneNumber" class="text-decoration-none text-secondary dir-ltr d-inline-block">
                                    <i class="fa-solid fa-phone me-1 small text-muted"></i>@customer.PhoneNumber
                                </a>
                            </td>
                            <td class="text-muted small text-truncate" style="max-width: 200px;" title="@customer.Address">
                                @(string.IsNullOrWhiteSpace(customer.Address) ? "-" : customer.Address)
                            </td>
                            <td>
                                @if (customer.HasAccount)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">نعم</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">لا</span>
                                }
                            </td>
                            <td class="fw-semibold">@customer.OrdersCount</td>
                            <td>
                                @if (customer.CreditOrdersCount > 0)
                                {
                                    <span class="badge bg-warning text-dark fw-bold">@customer.CreditOrdersCount</span>
                                }
                                else
                                {
                                    <span class="text-muted small">0</span>
                                }
                            </td>
                            <td class="fw-bold @(customer.TotalCreditDue > 0 ? "text-danger" : "text-dark")">
                                @customer.TotalCreditDue.ToString("N2") ج.م
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@customer.Id" class="btn btn-sm btn-outline-secondary" title="عرض الملف الشخصي">
                                        <i class="fa-solid fa-user me-1"></i> الملف
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@customer.Id" method="post" class="js-delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف العميل">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-3 rounded-4">
        <div class="py-4">
            <div class="feature-icon mb-3 mx-auto">
                <i class="fa-solid fa-users text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">لم يتم العثور على عملاء</h5>
            <p class="text-muted small mb-0">جرّب البحث باسم آخر أو تأكد من إدخال رقم الهاتف بشكل صحيح.</p>
        </div>
    </div>
}