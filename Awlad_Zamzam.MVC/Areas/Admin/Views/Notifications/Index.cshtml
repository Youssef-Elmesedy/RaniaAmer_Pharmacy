@model List<OrderListItemViewModel>
@{
    ViewData["Title"] = "الإشعارات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-notifications.css" asp-append-version="true" />
}

<h3 class="fw-bold mb-4"><i class="fa-solid fa-bell me-2"></i>الإشعارات - طلبات بانتظار التنفيذ</h3>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="fa-solid fa-bell-slash fa-3x mb-3"></i>
        <p>لا توجد طلبات جديدة</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm p-3 d-flex flex-row justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <div class="fw-bold">
                            @order.CustomerName
                            @if (order.IsCredit)
                            {
                                <span class="badge bg-warning text-dark ms-2">آجل</span>
                            }
                        </div>
                        <div class="text-muted small">
                            @order.CustomerPhone &middot; @order.ItemsCount صنف &middot; @order.OrderDate.ToString("yyyy-MM-dd HH:mm")
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span class="fw-bold price-new">@order.Total.ToString("0.00") ج.م</span>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-brand">
                            عرض وتسليم الطلب
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
