@model List<OfferViewModel>
@{
    ViewData["Title"] = "العروض المجمّعة والحصرية";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/offers.css" asp-append-version="true" />
}

<div class="bg-white border-bottom py-4 mb-4 shadow-sm">
    <div class="container">
        <h2 class="fw-bold mb-1"><i class="fa-solid fa-tags me-2 text-warning"></i>عروضنا الحصرية</h2>
        <p class="text-muted small mb-0">مجموعات مميزة من منتجاتنا بأسعار خاصة جداً</p>
    </div>
</div>

<div class="container pb-5">
    @if (!Model.Any())
    {
        <div class="text-center py-5 card border-0 shadow-sm p-5 rounded-4">
            <div class="offers-empty-icon mb-4 text-warning">
                <i class="fa-solid fa-tags fa-2x"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">لا توجد عروض نشطة حالياً</h4>
            <p class="text-muted mb-4">تابعنا قريباً لتستمتع بأقوى العروض والخصومات المجمّعة!</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-brand btn-lg px-5 rounded-pill shadow-sm">
                <i class="fa-solid fa-utensils me-2"></i>تصفح المنتجات العادية
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var offer in Model)
            {
                <div class="col-12 col-lg-6">
                    <div class="card product-card p-4 h-100 border-0 shadow-sm rounded-4 d-flex flex-column">
                        <!-- رأس الكارت والعنوان -->
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="fw-bold text-dark mb-0">@offer.Title</h4>
                            @if (offer.TotalSavings > 0)
                            {
                                <span class="badge badge-offer px-3 py-2 rounded-pill">وفر @offer.TotalSavings.ToString("N2") ج.م</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(offer.Description))
                        {
                            <p class="text-muted small mb-3">@offer.Description</p>
                        }

                        <!-- عناصر العرض -->
                        <div class="row g-3 mb-4">
                            @foreach (var item in offer.Items)
                            {
                                <div class="col-4">
                                    <div class="text-center border border-light rounded-3 p-2 h-100 bg-light bg-opacity-50">
                                        <div class="offer-img-wrapper mb-2 rounded-2 overflow-hidden bg-white border">
                                            <img src="@(item.ProductImagePath ?? "/images/product-placeholder.svg")" class="w-100 h-100 object-fit-cover" alt="@item.ProductName" />
                                        </div>
                                        <div class="small fw-bold text-dark text-truncate mb-1" title="@item.ProductName">@item.ProductName</div>
                                        <div class="extra-small">
                                            <span class="price-old d-block text-muted">@item.OriginalPrice.ToString("N2")</span>
                                            <span class="price-new fw-bold text-danger">@item.SpecialPrice.ToString("N2")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- إجمالي العرض والسعر -->
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top border-light">
                            <div>
                                <span class="extra-small text-muted d-block">سعر العرض الإجمالي</span>
                                <div>
                                    <span class="price-old small text-decoration-line-through me-2">@offer.TotalOriginalPrice.ToString("N2") ج.م</span>
                                    <span class="price-new fs-4 fw-bold text-danger">@offer.TotalSpecialPrice.ToString("N2") ج.م</span>
                                </div>
                            </div>
                        </div>

                        <!-- أزرار إضافة محتويات العرض أو العرض كاملاً للسلة -->
                        <div class="mt-3 pt-2 d-flex flex-wrap gap-2">
                            @foreach (var item in offer.Items)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@Url.Action("Index", "Offers")" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100 rounded-pill py-2 text-truncate" title="أضف @item.ProductName">
                                        <i class="fa-solid fa-cart-plus me-1 text-danger"></i> أضف @item.ProductName
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>