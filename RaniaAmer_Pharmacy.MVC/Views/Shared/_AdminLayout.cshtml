@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - لوحة تحكم صيدلية رانيا عامر</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Google Fonts (Cairo) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        Func<string, string> isActive = c => currentController == c ? "active" : "";
        var user = await UserManager.GetUserAsync(User);
    }

    <!-- Top Admin Navbar -->
    <nav class="navbar navbar-expand-xl navbar-dark sticky-top admin-navbar py-2">
        <div class="container-fluid px-3 px-lg-4">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                <i class="fa-solid fa-mortar-pestle text-warning fs-4"></i>
                <span>لوحة تحكم صيدلية رانيا عامر</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav" aria-controls="adminNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse mt-2 mt-xl-0" id="adminNav">
                <!-- Main Nav Links -->
                <ul class="navbar-nav me-auto gap-1 py-2 py-xl-0">
                    <li class="nav-item">
                        <a class="nav-link @isActive("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                            <i class="fa-solid fa-gauge me-1"></i> لوحة التحكم
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Products")" asp-controller="Products" asp-action="Index">
                            <i class="fa-solid fa-mortar-pestle me-1"></i> المنتجات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Categories")" asp-controller="Categories" asp-action="Index">
                            <i class="fa-solid fa-tags me-1"></i> الأقسام
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Customers")" asp-controller="Customers" asp-action="Index">
                            <i class="fa-solid fa-users me-1"></i> العملاء
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Offers")" asp-controller="Offers" asp-action="Index">
                            <i class="fa-solid fa-gift me-1"></i> العروض
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Orders")" asp-controller="Orders" asp-action="Index">
                            <i class="fa-solid fa-receipt me-1"></i> الطلبات
                            @await Component.InvokeAsync("PendingOrdersBadge")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Notifications")" asp-controller="Notifications" asp-action="Index">
                            <i class="fa-solid fa-bell me-1"></i> الإشعارات
                            @await Component.InvokeAsync("PendingOrdersBadge")
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("Payments")" asp-controller="Payments" asp-action="Index">
                            <i class="fa-solid fa-money-bill-wave me-1"></i> المدفوعات
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @isActive("DataCleanup")" asp-controller="DataCleanup" asp-action="Index">
                            <i class="fa-solid fa-broom me-1"></i> تنظيف البيانات
                            @await Component.InvokeAsync("DataCleanupBadge")
                        </a>
                    </li>
                </ul>

                <!-- User & Account Links -->
                <ul class="navbar-nav align-items-xl-center gap-2 border-top border-xl-0 pt-2 pt-xl-0 mt-2 mt-xl-0">
                    <li class="nav-item">
                        <a class="nav-link text-white-50" asp-area="" asp-controller="Home" asp-action="Index" title="الانتقال للموقع">
                            <i class="fa-solid fa-globe me-1"></i> عرض المتجر
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-white-50 @isActive("Settings")" asp-controller="Settings" asp-action="Index" title="الإعدادات">
                            <i class="fa-solid fa-gear me-1"></i> الإعدادات
                        </a>
                    </li>

                    <li class="nav-item d-flex align-items-center gap-2 px-2 text-white my-2 my-xl-0">
                        <div class="user-avatar-circle">
                            @{
                                var displayName = user?.FullName;
                                if (string.IsNullOrWhiteSpace(displayName)) displayName = user?.UserName;
                            }
                            @(string.IsNullOrWhiteSpace(displayName) ? "A" : displayName.Trim().Substring(0, 1).ToUpper())
                        </div>
                        <span class="fw-semibold small">
                            @(user?.FullName ?? user?.UserName ?? "المدير")
                        </span>
                    </li>

                    <li class="nav-item">
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-light rounded-pill px-3 w-100">
                                <i class="fa-solid fa-right-from-bracket me-1"></i> خروج
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Body -->
    <main class="admin-content p-3 p-lg-4">
        <!-- Toast Alerts Data Container -->
        <div id="toast-data" class="d-none"
             data-success="@TempData["SuccessMessage"]"
             data-error="@TempData["ErrorMessage"]"></div>

        <!-- Page Loader -->
        <div id="page-loader" class="page-loader">
            <div class="spinner-border text-danger" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">جاري التحميل...</span>
            </div>
        </div>

        @RenderBody()
    </main>

    <div id="push-notifications-root" class="d-none"
         data-subscribe-endpoint="/push/subscribe/admin"
         data-unsubscribe-endpoint="/push/unsubscribe"></div>

    <!-- Core Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/admin-notifications.js" asp-append-version="true"></script>
    <script src="~/js/push-notifications.js" asp-append-version="true"></script>
    <script src="~/js/realtime-notifications.js" asp-append-version="true"></script>

    <script>
            // Hide loader safely when page finishes loading
            window.addEventListener('load', function () {
                const loader = document.getElementById('page-loader');
                if (loader) {
                    loader.style.opacity = '0';
                    setTimeout(() => {
                        loader.style.display = 'none';
                    }, 300); // 300ms transition time
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>