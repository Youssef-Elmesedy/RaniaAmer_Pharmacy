@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject RaniaAmer_Pharmacy.MVC.Services.Interfaces.ISiteSettingsService SiteSettingsService
@inject RaniaAmer_Pharmacy.MVC.Services.Interfaces.IBranchService BranchService
@{
    var storeSettings = await SiteSettingsService.GetAsync();
    var branches = await BranchService.GetAllAsync();
    var mainBranch = branches.FirstOrDefault();
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - @storeSettings.PharmacyName</title>
    <link rel="icon" type="image/svg+xml" href="~/images/favicon.svg" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark sticky-top main-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-mortar-pestle me-2"></i>@storeSettings.PharmacyName
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between" id="mainNav">
                <ul class="navbar-nav mx-auto text-center gap-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">الرئيسية</a></li>
                    @await Component.InvokeAsync("CategoryNav")
                    <li class="nav-item"><a class="nav-link" asp-controller="Offers" asp-action="Index">العروض</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Customer" asp-action="Index">تواصل معنا</a></li>
                </ul>

                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @await Component.InvokeAsync("CartSummary")

                    @{
                        var customerAuthResult = await Context.AuthenticateAsync(RaniaAmer_Pharmacy.MVC.Controllers.CustomerAccountController.SchemeName);
                    }
                    @if (customerAuthResult.Succeeded)
                    {
                        var userName = customerAuthResult.Principal!.Identity!.Name ?? "";
                        var firstLetter = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                                <!-- دائرة الحرف الأول -->
                                <span class="user-avatar-circle">
                                    @firstLetter
                                </span>
                                <span>@userName</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="CustomerAccount" asp-action="MyOrders"><i class="fa-solid fa-receipt me-2"></i>طلباتي</a></li>
                                <li><a class="dropdown-item" asp-controller="CustomerAccount" asp-action="MyCreditOrders"><i class="fa-solid fa-clock me-2"></i>فواتير الآجل</a></li>
                                <li><a class="dropdown-item" asp-controller="CustomerAccount" asp-action="Profile"><i class="fa-solid fa-user-gear me-2"></i>الملف الشخصي</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a asp-controller="CustomerAccount"
                                       asp-action="Logout"
                                       class="dropdown-item text-danger d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-right-from-bracket"></i>
                                        <span>تسجيل الخروج</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="CustomerAccount" asp-action="Login">
                                <i class="fa-solid fa-user me-1"></i>تسجيل الدخول
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <a class="nav-link btn btn-sm btn-outline-light px-3" asp-area="Admin" asp-controller="Dashboard" asp-action="Index" title="الرجوع للوحة التحكم">
                                <i class="fa-solid fa-gauge me-1"></i>لوحة التحكم
                            </a>
                        }
                        else
                        {
                            <a class="nav-link opacity-50" asp-controller="Account" asp-action="Login" title="دخول الإدارة">
                                <i class="fa-solid fa-user-shield"></i>
                            </a>
                        }
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div id="toast-data" class="d-none"
         data-success="@TempData["SuccessMessage"]"
         data-error="@TempData["ErrorMessage"]"></div>

    <div id="page-loader" class="page-loader">
        <div class="spinner-border" style="color:var(--brand-red);width:3rem;height:3rem" role="status"></div>
    </div>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-4">
                    <h5><i class="fa-solid fa-mortar-pestle me-2"></i>@storeSettings.PharmacyName</h5>
                    <p class="text-white-50">أدوية أصلية ومستلزمات طبية موثوقة، بخبرة تمتد لسنوات نقدم لكم الجودة والثقة.</p>
                    @if (!string.IsNullOrWhiteSpace(storeSettings.FacebookUrl) || !string.IsNullOrWhiteSpace(storeSettings.InstagramUrl))
                    {
                        <div class="d-flex gap-2 mt-2">
                            @if (!string.IsNullOrWhiteSpace(storeSettings.FacebookUrl))
                            {
                                <a href="@storeSettings.FacebookUrl" target="_blank" class="text-white-50" title="فيسبوك"><i class="fab fa-facebook fs-5"></i></a>
                            }
                            @if (!string.IsNullOrWhiteSpace(storeSettings.InstagramUrl))
                            {
                                <a href="@storeSettings.InstagramUrl" target="_blank" class="text-white-50" title="إنستجرام"><i class="fab fa-instagram fs-5"></i></a>
                            }
                        </div>
                    }
                </div>
                <div class="col-md-4">
                    <h5>روابط سريعة</h5>
                    <div class="footer-links">
                        <a asp-controller="Home" asp-action="Index">الرئيسية</a>
                        <a asp-controller="Products" asp-action="Index">المنتجات</a>
                        <a asp-controller="Customer" asp-action="Index">تواصل معنا</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <h5>تواصل معنا</h5>
                    @if (mainBranch != null)
                    {
                        <p class="text-white-50 mb-1"><i class="fa-solid fa-phone me-2"></i>@mainBranch.PhoneNumber</p>
                        <p class="text-white-50 mb-1"><i class="fa-solid fa-location-dot me-2"></i>@mainBranch.Address</p>
                        <p class="text-white-50 mb-1"><i class="fa-solid fa-clock me-2"></i>@mainBranch.WorkingHours</p>
                        @if (branches.Count > 1)
                        {
                            <a asp-controller="Customer" asp-action="Index" class="text-white-50 small">
                                <i class="fa-solid fa-store me-1"></i>عرض كل الفروع (@branches.Count)
                            </a>
                        }
                    }
                </div>
            </div>
            <hr class="border-secondary" />
            <p class="text-center text-white-50 mb-0">&copy; @DateTime.Now.Year @storeSettings.PharmacyName. جميع الحقوق محفوظة.</p>
        </div>
    </footer>

    @{
        var pushAuthResult = await Context.AuthenticateAsync(RaniaAmer_Pharmacy.MVC.Controllers.CustomerAccountController.SchemeName);
    }
    @if (pushAuthResult.Succeeded)
    {
        <div id="push-notifications-root" class="d-none"
             data-subscribe-endpoint="/push/subscribe/customer"
             data-unsubscribe-endpoint="/push/unsubscribe"></div>
    }

    <script>
            // إذا رجع المستخدم للصفحة عن طريق زر الرجوع في المتصفح بعد الخروج، يتم عمل Refresh آلي
            window.addEventListener('pageshow', function (event) {
                if (event.persisted) {
                    window.location.reload();
                }
            });
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/catalog-watch.js" asp-append-version="true"></script>
    <script src="~/js/push-notifications.js" asp-append-version="true"></script>
    <script src="~/js/realtime-notifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
