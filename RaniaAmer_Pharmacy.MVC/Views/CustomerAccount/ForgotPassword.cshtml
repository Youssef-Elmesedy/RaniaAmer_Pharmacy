@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "نسيت كلمة المرور";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/customer-account.css" asp-append-version="true" />
}

<div class="customer-login-page">
    <div class="login-bg">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100 py-5">
            <div class="col-xl-5 col-lg-6 col-md-8">

                <a asp-action="Login" class="back-home">
                    <i class="fa-solid fa-arrow-right"></i>
                    الرجوع لتسجيل الدخول
                </a>

                <div class="login-card">
                    <div class="text-center mb-4">
                        <div class="logo-circle">
                            <i class="fa-solid fa-key"></i>
                        </div>
                        <h2 class="fw-bold mt-4">نسيت كلمة المرور؟</h2>
                        <p class="text-muted">أدخل رقم الهاتف المسجل وسنعرض عليك سؤال الأمان الخاص بك</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <div class="input-group-custom">
                                <i class="fa-solid fa-phone"></i>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="01xxxxxxxxx" autofocus />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn-login">
                            <i class="fa-solid fa-arrow-left me-2"></i>
                            متابعة
                        </button>
                    </form>

                    <div class="register-box">
                        تذكرت كلمة المرور؟
                        <a asp-action="Login" class="ms-1">تسجيل الدخول</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}