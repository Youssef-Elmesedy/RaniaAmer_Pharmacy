@model AdminProductListViewModel
@{
    ViewData["Title"] = "المنتجات";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-products.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">قائمة المنتجات</h3>
        <p class="text-muted small mb-0">إدارة منتجات الصيدلية، الأسعار، الخصومات وحالة التوفر</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="SaleUnits" asp-action="Index" class="btn btn-outline-secondary text-nowrap">
            <i class="fa-solid fa-ruler me-1"></i> وحدات البيع
        </a>
        <a asp-action="Create" class="btn btn-brand text-nowrap">
            <i class="fa-solid fa-plus me-1"></i> إضافة منتج جديد
        </a>
    </div>
</div>

<!-- فلتر البحث -->
<div class="card border-0 shadow-sm p-3 mb-4 rounded-4">
    <form method="get" class="row g-2">
        <div class="col-12 col-md-9">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control border-start-0 ps-0 js-live-search" placeholder="بحث باسم المنتج أو القسم..." autocomplete="off" />
            </div>
        </div>
        <div class="col-12 col-md-3">
            <button type="submit" class="btn btn-brand w-100">
                <i class="fa-solid fa-filter me-1"></i> بحث
            </button>
        </div>
    </form>
</div>

@if (Model != null && Model.Products.Any())
{
    <p class="text-muted small mb-2">
        إجمالي المنتجات: <strong>@Model.TotalCount</strong>
    </p>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;">الصورة</th>
                        <th>الاسم</th>
                        <th>القسم</th>
                        <th>السعر / الوحدة</th>
                        <th>الخصم</th>
                        <th>الحالة</th>
                        <th class="text-end">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="product-img-wrapper">
                                    <img src="@(product.ImagePath ?? "/images/product-placeholder.svg")" alt="@product.Name" class="product-thumb-img rounded-3" />
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@product.Name</div>
                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                {
                                    <div class="text-muted extra-small text-truncate" style="max-width: 220px;">@product.Description</div>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-layer-group text-muted me-1"></i>@(string.IsNullOrWhiteSpace(product.CategoryName) ? "بدون قسم" : product.CategoryName)
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@product.Price.ToString("N2") ج.م</div>
                                <span class="extra-small text-muted">
                                    لكل @(string.IsNullOrWhiteSpace(product.SaleUnitName) ? "-" : product.SaleUnitName)
                                </span>
                            </td>
                            <td>
                                @if (product.DiscountPercentage > 0)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill px-2.5 py-1">
                                        خصم @product.DiscountPercentage%
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted extra-small">-</span>
                                }
                            </td>
                            <td>
                                @if (product.IsAvailable)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-2.5 py-1">
                                        متوفر
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary border rounded-pill px-2.5 py-1">
                                        غير متوفر
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex align-items-center justify-content-end gap-1.5">
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary rounded-3" title="تعديل">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="js-delete-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="حذف">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-4" aria-label="Page navigation">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-search="@Model.SearchTerm" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-4 rounded-4">
        <div class="py-4">
            <div class="product-empty-icon mb-3 mx-auto">
                <i class="fa-solid fa-boxes-stacked text-muted fs-1"></i>
            </div>
            @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
            {
                <h5 class="fw-bold text-dark mb-1">لا توجد نتائج مطابقة</h5>
                <p class="text-muted small mb-3">جرّب اسمًا آخر، أو <a asp-action="Index" class="text-decoration-none">امسح البحث</a> لعرض كل المنتجات.</p>
            }
            else
            {
                <h5 class="fw-bold text-dark mb-1">لا توجد منتجات مضافة بعد</h5>
                <p class="text-muted small mb-3">ابدأ بإضافة منتجات وأصناف الصيدلية الآن.</p>
                <a asp-action="Create" class="btn btn-brand btn-sm px-4 py-2">
                    <i class="fa-solid fa-plus me-1"></i> إضافة أول منتج
                </a>
            }
        </div>
    </div>
}