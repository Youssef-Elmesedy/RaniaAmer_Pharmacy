@model OfferFormViewModel
@{
    ViewData["Title"] = "تعديل العرض";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-offers.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">تعديل بيانات العرض</h3>
        <p class="text-muted small mb-0">تحديث تفاصيل العرض والمنتجات المشمولة فيه</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> رجوع للعروض
    </a>
</div>

<div class="card border-0 shadow-sm p-4 rounded-4">
    <form asp-action="Edit" method="post">
        @await Html.PartialAsync("_OfferForm", Model)
    </form>
</div>