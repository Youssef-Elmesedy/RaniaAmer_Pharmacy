@model OfferFormViewModel

<input type="hidden" asp-for="Id" />
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3" role="alert"></div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-8">
        <label asp-for="Title" class="form-label fw-bold">عنوان العرض</label>
        <input asp-for="Title" class="form-control" placeholder="مثال: عرض نهاية الأسبوع، خصم الفيتامينات..." />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-4 d-flex align-items-center pt-md-3">
        <div class="form-check form-switch bg-light p-2.5 rounded-3 border w-100 d-flex align-items-center justify-content-between px-3">
            <label asp-for="IsActive" class="form-check-label fw-bold mb-0">تفعيل العرض فوراً</label>
            <input asp-for="IsActive" class="form-check-input ms-0" type="checkbox" role="switch" />
        </div>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label fw-bold">وصف العرض</label>
        <textarea asp-for="Description" class="form-control" rows="2" placeholder="أدخل تفاصيل ومميزات العرض..."></textarea>
        <span asp-validation-for="Description" class="text-danger small"></span>
    </div>
</div>

<hr class="my-4" />

<div class="d-flex align-items-center justify-content-between mb-3">
    <div>
        <h6 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-boxes-stacked me-2 text-danger"></i>اختر المنتجات وسعر العرض</h6>
        <p class="text-muted small mb-0">حدد المنتجات المشاركة وضَع سعر العرض الخاص لكل صنف</p>
    </div>
</div>

<span asp-validation-for="SelectedProductIds" class="text-danger d-block mb-3"></span>

<div class="row g-3">
    @foreach (var product in Model.AllProducts)
    {
        var isChecked = Model.SelectedProductIds.Contains(product.Id);
        var specialPrice = Model.SpecialPrices.GetValueOrDefault(product.Id, product.Price);

        <div class="col-12 col-md-6">
            <div class="offer-product-item p-3 border rounded-4 d-flex align-items-center gap-3 @(isChecked ? "selected-product" : "")">
                <input type="checkbox" class="form-check-input offer-product-check flex-shrink-0"
                       name="SelectedProductIds" value="@product.Id" @(isChecked ? "checked" : "") />

                <img src="@(product.ImagePath ?? "/images/product-placeholder.svg")" class="product-thumb rounded-3" alt="@product.Name" />

                <div class="flex-grow-1 overflow-hidden">
                    <div class="fw-bold text-dark text-truncate small">@product.Name</div>
                    <div class="text-muted small">الأصلي: <span class="fw-semibold">@product.Price.ToString("N2")</span> / @product.UnitLabel</div>
                </div>

                <div class="special-price-input flex-shrink-0">
                    <label class="form-label text-muted extra-small mb-1 d-block">سعر العرض</label>
                    <div class="input-group input-group-sm">
                        <input type="number" step="0.01" class="form-control text-center fw-bold text-danger"
                               name="SpecialPrice_@product.Id" value="@specialPrice.ToString("0.00")" placeholder="0.00" />
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-4 pt-3 border-top d-flex gap-2">
    <button type="submit" class="btn btn-brand px-4">
        <i class="fa-solid fa-floppy-disk me-1"></i> حفظ العرض
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary px-4">إلغاء</a>
</div>