@model List<BranchViewModel>
@{
    ViewData["Title"] = "الفروع";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">إدارة الفروع</h3>
        <p class="text-muted small mb-0">أضيفي فرع أو أكتر — كل فرع بعنوانه ورقمه ومواعيده وخريطته الخاصة، وكلهم بيظهروا على نفس الموقع</p>
    </div>
    <a asp-action="Create" class="btn btn-brand text-nowrap">
        <i class="fa-solid fa-plus me-1"></i> إضافة فرع جديد
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-3">
        @foreach (var branch in Model)
        {
            <div class="col-12 col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="fw-bold text-dark mb-0">
                                <i class="fa-solid fa-store text-brand me-1"></i> @branch.Name
                            </h5>
                            <span class="badge bg-light text-dark border">ترتيب @branch.DisplayOrder</span>
                        </div>

                        <p class="text-muted small mb-2">
                            <i class="fa-solid fa-phone me-1"></i> @branch.PhoneNumber
                        </p>
                        <p class="text-muted small mb-2">
                            <i class="fa-solid fa-location-dot me-1"></i> @branch.Address
                        </p>
                        <p class="text-muted small mb-2">
                            <i class="fa-solid fa-clock me-1"></i> @branch.WorkingHours
                        </p>
                        @if (!string.IsNullOrWhiteSpace(branch.DeliveryAreaText))
                        {
                            <p class="text-muted small mb-0">
                                <i class="fa-solid fa-truck-fast me-1"></i> @branch.DeliveryAreaText
                            </p>
                        }

                        <div class="d-flex gap-2 mt-3 pt-3 border-top">
                            <a asp-action="Edit" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-secondary">
                                <i class="fa-solid fa-pen me-1"></i> تعديل
                            </a>
                            <form asp-action="Delete" asp-route-id="@branch.Id" method="post" class="js-delete-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" @(Model.Count <= 1 ? "disabled title=\"لازم يفضل فرع واحد على الأقل\"" : "")>
                                    <i class="fa-solid fa-trash me-1"></i> حذف
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="py-4">
            <div class="feature-icon mb-3 mx-auto">
                <i class="fa-solid fa-store text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">لا يوجد أي فرع مضاف بعد</h5>
            <p class="text-muted mb-4">أضيفي الفرع الأول عشان يظهر عنوانك ورقمك للعملاء.</p>
            <a asp-action="Create" class="btn btn-brand px-4">
                <i class="fa-solid fa-plus me-1"></i> إضافة فرع الآن
            </a>
        </div>
    </div>
}
