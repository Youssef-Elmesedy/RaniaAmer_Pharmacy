@model SaleUnitFormViewModel

<input type="hidden" asp-for="Id" />

<div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm mb-3"></div>

<div class="row g-4">
    <div class="col-12 col-md-6">
        <label asp-for="Name" class="form-label fw-semibold text-dark">اسم الوحدة <span class="text-danger">*</span></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-ruler text-muted"></i></span>
            <input asp-for="Name" class="form-control border-start-0 ps-0" placeholder="مثال: شريط، علبة، قرص..." />
        </div>
        <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
    </div>
</div>

<div class="mt-4 pt-3 border-top d-flex flex-wrap gap-2">
    <button type="submit" class="btn btn-brand px-4">
        <i class="fa-solid fa-floppy-disk me-1"></i> حفظ البيانات
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary px-4">
        <i class="fa-solid fa-xmark me-1"></i> إلغاء
    </a>
</div>
