@model List<SaleUnitViewModel>
@{
    ViewData["Title"] = "وحدات البيع";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">إدارة وحدات البيع</h3>
        <p class="text-muted small mb-0">الوحدات المتاحة لبيع المنتجات بها (قطعة، علبة، شريط...) — تظهر في نموذج إضافة المنتج</p>
    </div>
    <a asp-action="Create" class="btn btn-brand text-nowrap">
        <i class="fa-solid fa-plus me-1"></i> إضافة وحدة جديدة
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">اسم الوحدة</th>
                        <th>عدد المنتجات المرتبطة</th>
                        <th class="text-end pe-4">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var unit in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">@unit.Name</td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="fa-solid fa-box me-1 text-muted"></i> @unit.ProductsCount منتج
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="fa-solid fa-pen me-1"></i> تعديل
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@unit.Id" method="post" class="js-delete-form">
                                        @Html.AntiForgeryToken()
                                        @if (unit.ProductsCount > 0)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" disabled
                                                    title="لا يمكن حذف وحدة مرتبطة بمنتجات">
                                                <i class="fa-solid fa-trash me-1"></i> حذف
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash me-1"></i> حذف
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm p-5 text-center my-4">
        <div class="py-4">
            <div class="feature-icon mb-3 mx-auto">
                <i class="fa-solid fa-ruler text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">لا توجد وحدات بيع مضافة بعد</h5>
            <p class="text-muted mb-4">أضف وحدات مثل قطعة، علبة، شريط، قرص... لاستخدامها عند إضافة المنتجات.</p>
            <a asp-action="Create" class="btn btn-brand px-4">
                <i class="fa-solid fa-plus me-1"></i> إضافة وحدة الآن
            </a>
        </div>
    </div>
}
