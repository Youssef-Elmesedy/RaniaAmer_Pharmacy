@model List<OrderListItemViewModel>
@{
    ViewData["Title"] = "الإشعارات والطلبات المعلقة";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-notifications.css" asp-append-version="true" />
}

<!-- ترويسة الصفحة -->
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h3 class="admin-page-title mb-0">الإشعارات والطلبات الجديدة</h3>
            @if (Model.Any())
            {
                <span class="badge bg-danger rounded-pill px-2.5 py-1 fs-6">@Model.Count</span>
            }
        </div>
        <p class="text-muted small mb-0">قائمة الطلبات المعلقة التي تنتظر التجهيز والتسليم</p>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center my-4 rounded-4">
        <div class="py-4">
            <div class="notification-empty-icon mb-3 mx-auto">
                <i class="fa-solid fa-bell-slash text-muted fs-1"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">لا توجد طلبات جديدة حالياً</h5>
            <p class="text-muted small mb-0">جميع الطلبات تم معالجتها بنجاح. ستظهر الطلبات القادمة هنا فور وصولها.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model)
        {
            <div class="col-12">
                <div class="card notification-card border-0 shadow-sm p-3 rounded-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="notification-icon bg-danger bg-opacity-10 text-danger flex-shrink-0">
                            <i class="fa-solid fa-bag-shopping fs-5"></i>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                <span class="fw-bold text-dark fs-6">@order.CustomerName</span>
                                <span class="badge bg-light text-dark border">#@order.OrderNumber</span>
                                @if (order.IsCredit)
                                {
                                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>آجل</span>
                                }
                            </div>
                            <div class="text-muted small d-flex flex-wrap align-items-center gap-2">
                                <span class="dir-ltr"><i class="fa-solid fa-phone me-1 small"></i>@order.CustomerPhone</span>
                                <span>&bull;</span>
                                <span><i class="fa-solid fa-box-open me-1 small"></i>@order.ItemsCount صنف</span>
                                <span>&bull;</span>
                                <span><i class="fa-regular fa-clock me-1 small"></i>@order.OrderDate.ToEgyptTime().ToString("yyyy-MM-dd hh:mm tt")</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between justify-content-sm-end gap-3 w-100 w-sm-auto pt-2 pt-sm-0 border-top border-sm-0">
                        <div class="text-start text-sm-end">
                            <span class="text-muted small d-block d-sm-none">الإجمالي</span>
                            <span class="fw-bold fs-5 text-danger">@order.Total.ToString("N2") <small class="fs-6">ج.م</small></span>
                        </div>
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-brand btn-sm px-3 rounded-3 fw-semibold">
                            <i class="fa-solid fa-receipt me-1"></i> عرض والتسليم
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}