@model CreditOrderFormViewModel
@{
    ViewData["Title"] = "تسجيل طلب آجل جديد";
    var customerItems = Model.Customers.Select(c => new SelectListItem
    {
        Text = $"{c.Name} - {c.PhoneNumber}",
        Value = c.Id.ToString()
    });
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin-orders.css" asp-append-version="true" />
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h3 class="admin-page-title mb-1">تسجيل طلب آجل جديد</h3>
        <p class="text-muted small mb-0">اختر العملاء والأصناف لتسجيل المبيعات الآجلة فوراً</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="fa-solid fa-arrow-right me-1"></i> رجوع للطلبات
    </a>
</div>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

    <div class="row g-4">
        <!-- قسم العميل -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                    <i class="fa-solid fa-circle-user me-2 text-danger"></i>بيانات العميل
                </h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold small">البحث عن عميل مسجل</label>
                    <input type="text" id="customerSearchBox" class="form-control mb-2" placeholder="اكتب الاسم أو الهاتف للفلترة..." autocomplete="off" />

                    <select asp-for="CustomerId" class="form-select" id="customerSelect" asp-items="customerItems">
                        <option value="">-- عميل جديد (سجل البيانات بالأسفل) --</option>
                    </select>
                </div>

                <div id="newCustomerFields" class="bg-light p-3 rounded-3 border mb-3">
                    <div class="alert alert-info py-2 small mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i> في حال عدم وجود العميل بالقائمة، أدخل بياناته وسيتسجل تلقائياً.
                    </div>

                    <div class="mb-2">
                        <label asp-for="NewCustomerName" class="form-label fw-semibold small">اسم العميل</label>
                        <input asp-for="NewCustomerName" class="form-control" placeholder="الاسم ثلاثي" />
                        <span asp-validation-for="NewCustomerName" class="text-danger extra-small"></span>
                    </div>
                    <div class="mb-2">
                        <label asp-for="NewCustomerPhone" class="form-label fw-semibold small">رقم الهاتف</label>
                        <input asp-for="NewCustomerPhone" class="form-control" placeholder="01xxxxxxxxx" />
                        <span asp-validation-for="NewCustomerPhone" class="text-danger extra-small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="NewCustomerAddress" class="form-label fw-semibold small">العنوان</label>
                        <textarea asp-for="NewCustomerAddress" class="form-control" rows="2" placeholder="تفاصيل العنوان..."></textarea>
                        <span asp-validation-for="NewCustomerAddress" class="text-danger extra-small"></span>
                    </div>
                </div>

                <div class="mb-0">
                    <label asp-for="Notes" class="form-label fw-semibold small">ملاحظات على الطلب</label>
                    <textarea asp-for="Notes" class="form-control" rows="2" placeholder="أي تفاصيل خاصة بالدفع أو الموعد..."></textarea>
                </div>
            </div>
        </div>

        <!-- قسم اختيار أصناف الطلب -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm p-4 rounded-4 mb-4">
                <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                    <i class="fa-solid fa-mortar-pestle me-2 text-danger"></i>الأصناف والكميات
                </h5>
                <span asp-validation-for="SelectedProductIds" class="text-danger d-block mb-2 extra-small"></span>

                <div class="row g-2.5 credit-order-products">
                    @foreach (var product in Model.AllProducts)
                    {
                        var isChecked = Model.SelectedProductIds.Contains(product.Id);
                        var quantity = Model.Quantities.GetValueOrDefault(product.Id, 1);

                        <div class="col-12 col-md-6">
                            <div class="credit-product-item border rounded-3 p-2.5 d-flex align-items-center gap-2 @(isChecked ? "selected-product" : "")">
                                <input type="checkbox" class="form-check-input credit-product-check flex-shrink-0"
                                       name="SelectedProductIds" value="@product.Id" @(isChecked ? "checked" : "") />

                                <img src="@(product.ImagePath ?? "/images/product-placeholder.svg")" class="product-thumb rounded-3" alt="@product.Name" />

                                <div class="flex-grow-1 overflow-hidden">
                                    <div class="small fw-bold text-dark text-truncate">@product.Name</div>
                                    <div class="extra-small text-muted">@product.Price.ToString("N2") ج.م / @product.UnitLabel</div>
                                </div>

                                <div class="quantity-input flex-shrink-0" style="width: 85px;">
                                    <input type="number" min="1" step="1" class="form-control form-control-sm text-center fw-bold"
                                           name="Quantity_@product.Id" value="@quantity.ToString("0")" placeholder="العدد" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-brand px-5 py-2.5 rounded-3">
                    <i class="fa-solid fa-floppy-disk me-1"></i> تسجيل الطلب كآجل
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2.5 rounded-3">إلغاء</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.getElementById('customerSearchBox').addEventListener('input', function () {
            var term = this.value.trim().toLowerCase();
            var select = document.getElementById('customerSelect');
            for (var i = 0; i < select.options.length; i++) {
                var opt = select.options[i];
                if (!opt.value) continue;
                opt.hidden = term.length > 0 && opt.text.toLowerCase().indexOf(term) === -1;
            }
        });

        function toggleNewCustomerFields() {
            var select = document.getElementById('customerSelect');
            var fields = document.getElementById('newCustomerFields');
            fields.style.display = select.value ? 'none' : 'block';
        }
        document.getElementById('customerSelect').addEventListener('change', toggleNewCustomerFields);
        toggleNewCustomerFields();
    </script>
}